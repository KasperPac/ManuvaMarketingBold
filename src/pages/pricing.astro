---
import Base from '../layouts/Base.astro';
import FeatureMatrix from '../components/site/FeatureMatrix.astro';
import { APP_URL } from '../site';

// Rebuilt on the new design (MVBOLD-17). Motion: none — the handoff is
// explicit that nothing pins on pricing. What carries is the full-field hero,
// display type, the plan cards, the FAQ and the ink comparison.
//
// Every figure is this repo's latest: AUD, and a 30-day trial. The handoff
// still says 14 days and USD; where the two disagree on fact the repo wins,
// and /terms section 4 is the authority on currency.

const PLANS = [
  {
    name: 'Starter', tagline: 'Small brands getting started with manufacturing ops', annual: '$99', monthly: '$119', badge: null,
    limit: '1 location · 3 users', monthlyLine: 'or $119/mo billed monthly',
    note: 'Billed $1,188/yr', monthlyNote: 'Billed $119/mo',
    feats: ['Inventory management', 'Basic BOM builder', 'Production orders', 'Purchase orders + suppliers', 'Stocktake', 'Email support'],
  },
  {
    name: 'Growth', tagline: 'Scaling brands with multi-location and deeper workflows', annual: '$249', monthly: '$299', badge: 'Most popular',
    limit: '5 locations · unlimited users', monthlyLine: 'or $299/mo billed monthly',
    note: 'Billed $2,988/yr', monthlyNote: 'Billed $299/mo',
    feats: ['Everything in Starter', 'Multi-location + bin locations', 'Advanced BOM (yield %, versions)', 'Costing module', 'Reports suite'],
  },
  {
    name: 'Pro', tagline: 'Professional manufacturers needing capacity, costing & advanced reporting', annual: '$499', monthly: '$599', badge: null,
    limit: 'Unlimited locations · unlimited users', monthlyLine: 'or $599/mo billed monthly',
    note: 'Billed $5,988/yr', monthlyNote: 'Billed $599/mo',
    feats: ['Everything in Growth', 'Capacity planning + staffing', 'Financial profitability', 'Advanced reports + PDF/CSV export', 'Priority support (< 4hr)'],
  },
  {
    name: 'Enterprise', tagline: 'Large operations, custom requirements, dedicated support', annual: 'Custom', monthly: 'Custom', badge: null,
    limit: 'Unlimited · SSO / SAML', monthlyLine: '',
    note: 'Annual contract · custom onboarding', monthlyNote: 'Annual contract · custom onboarding',
    feats: ['Everything in Pro', 'Dedicated account manager', 'Custom onboarding + training', 'SSO / advanced security', 'SLA + uptime guarantee'],
  },
];

const FAQS = [
  { q: 'What counts as a warehouse location?', a: "A location is any physical place you store components or finished goods — a warehouse, a storage room, a third-party facility. Bin/aisle areas within a single location don't count as additional locations." },
  { q: 'What do I get during the free trial?', a: 'Full Pro-level access for 30 days — no credit card required. At the end of the trial, your account downgrades to the tier you selected at sign-up. You can add a card and upgrade at any time during or after the trial.' },
  { q: 'Can I change tiers after signing up?', a: 'Yes — you can upgrade or downgrade at any time. Upgrades take effect immediately. Downgrades take effect at the next billing cycle.' },
  { q: 'Is pricing per seat or per account?', a: 'Flat per-account pricing — no per-seat fees. Growth and above include unlimited team members.' },
  { q: 'Do you offer discounts for annual billing?', a: 'Annual billing saves you around 17% compared to paying month-to-month — put another way, paying monthly costs about 20% more. The toggle above shows you both options.' },
];

const COMPARE: readonly (readonly [string, string, string])[] = [
  ['Pricing model', 'Flat per account', 'Per user, per month'],
  ['A 10-person team', '$249/mo', '$490/mo'],
  ['Yield % per BOM line', 'Included', 'Not offered'],
  ['BOM versioning & compare', 'Included', 'Not offered'],
  ['Capacity planning', 'Included on Pro', 'Not offered'],
];

const description =
  'Simple pricing for manufacturing teams. One price per tier, no per-seat fees, no usage meters. Start free for 30 days.';
const twitterDescription =
  'Simple pricing for manufacturing teams. One price per tier, no per-seat fees, no usage meters.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://manuva.app/' },
      { '@type': 'ListItem', position: 2, name: 'Pricing', item: 'https://manuva.app/pricing' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base
  title="Pricing — Manuva"
  description={description}
  twitterDescription={twitterDescription}
  canonical="https://manuva.app/pricing"
  current="/pricing"
  headInk="light"
  {schema}
>
  <section class="hero mv-field-cobalt">
    <span class="eyebrow" style="opacity:.75">Pricing</span>
    <h1 class="disp">One price. <span class="hl">Unlimited users.</span></h1>
    <p class="sub" style="opacity:.88">
      One price per tier. No per-seat fees. No usage meters. Start free for 30 days — no credit card required.
    </p>
    <div class="toggle" role="group" aria-label="Billing period">
      <button type="button" data-billing="annual" aria-pressed="true">Annual<small>Save 17%</small></button>
      <button type="button" data-billing="monthly" aria-pressed="false">Monthly</button>
    </div>
  </section>

  <div class="mv-field-cobalt">
    <div class="plans">
      {/* mv-field-paper, not a bare background. These cards sit inside the
          cobalt band, so they inherit --on-cobalt (white) — a card with a white
          background and no paired ink rendered white on white. A field class
          always sets both halves, which is the rule the whole system runs on. */}
      {PLANS.map((p) => (
        <div class={p.badge ? 'plan mv-field-ink' : 'plan mv-field-paper'}>
          <div class="name">
            <b>{p.name}</b>
            {p.badge && <span class="badge">{p.badge}</span>}
          </div>
          <p class="tagline">{p.tagline}</p>
          <div>
            <div class="price">
              <span class="num" data-annual={p.annual} data-monthly={p.monthly}>{p.annual}</span>
              {p.annual !== 'Custom' && <span class="per">/mo</span>}
            </div>
            <p class="note" data-annual={p.note} data-monthly={p.monthlyNote}>{p.note}</p>
            {p.monthlyLine && <p class="note monthly">{p.monthlyLine}</p>}
          </div>
          <span class="limit">{p.limit}</span>
          <a class={p.badge ? 'pill' : 'pill ink'} href={p.name === 'Enterprise' ? '/about#contact' : APP_URL}>
            {p.name === 'Enterprise' ? 'Contact sales' : 'Start free'}
          </a>
          <ul>{p.feats.map((f) => <li>{f}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>

  {/* The strip and the 43-row matrix, both dropped in the first rebuild pass.
      The matrix is a data table, so it stays on paper — the loud-layer rules
      are explicit that a field never sits behind one. */}
  <section class="sec">
    <div style="display:grid;gap:12px">
      <h2 class="disp">Compare every plan.</h2>
      <p class="sub" style="color:var(--ink-muted);max-width:56ch">
        Every feature, every tier. Nine categories, forty-three rows.
      </p>
    </div>
    <FeatureMatrix />
  </section>

  <p class="trialstrip">All plans include a 30-day free trial &middot; No credit card required</p>


  <section class="sec mv-field-ink">
    <div class="split">
      <div class="stick" style="display:grid;gap:20px">
        <span class="eyebrow" style="color:var(--field-amber)">Versus per-seat MRP</span>
        <h2 class="disp">Your team growing shouldn't cost more.</h2>
        <p class="sub" style="opacity:.75">
          Tools that charge per user punish you for putting Manuva on the floor. Growth and Pro include unlimited team members at a flat rate.
        </p>
      </div>
      <div class="ctable">
        <div class="r h">
          <span></span>
          <span class="eyebrow limechip">Manuva</span>
          <span class="eyebrow" style="opacity:.5">Per-seat MRP</span>
        </div>
        {COMPARE.map(([k, us, them]) => (
          <div class="r">
            <span class="k">{k}</span>
            <span class="us">{us}</span>
            <span class="them">{them}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <h2 class="disp">Frequently asked.</h2>
    <div class="faq">
      {FAQS.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="sub" style="max-width:68ch;font-size:15px;opacity:.7">
      Monthly pricing: Starter $119, Growth $299, Pro $599. Annual saves approximately 17%.
      Prices are in Australian Dollars (AUD); GST is included for Australian customers.
    </p>
  </section>

  <section class="outro mv-field-lime">
    <p class="disp">Start free. Decide later.</p>
    <p class="sub">30 days of full Pro access. No credit card required.</p>
    <div class="row">
      <a class="pill ink" href={APP_URL}>Start free</a>
      <a class="pill ghost" href="/features">See every feature</a>
    </div>
  </section>
</Base>

<script>
  // Progressive enhancement. The annual figures render server-side, so with
  // this script absent the page is still correct, just not switchable.
  const toggle = document.querySelector<HTMLElement>('.toggle');
  if (toggle) {
    const buttons = [...toggle.querySelectorAll<HTMLButtonElement>('[data-billing]')];
    const apply = (mode: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.billing === mode)));
      document.querySelectorAll<HTMLElement>('[data-annual]').forEach((el) => {
        el.textContent = mode === 'monthly' ? el.dataset.monthly! : el.dataset.annual!;
      });
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.billing!)));
  }
</script>
