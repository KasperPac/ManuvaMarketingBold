---
import Base from '../layouts/Base.astro';
import Panel from '../components/site/Panel.astro';
import PriceCards from '../components/site/PriceCards.astro';
import FeatureMatrix from '../components/site/FeatureMatrix.astro';
import FaqList from '../components/site/FaqList.astro';
import Field from '../components/site/Field.astro';
import TrialStrip from '../components/site/TrialStrip.astro';
import CtaBand from '../components/site/CtaBand.astro';

// Verbatim from the old page's five FAQ items — llms.txt only carries four of
// these (it drops "Can I change tiers after signing up?"); the old page has
// more, and the old page wins per the task brief.
const FAQS = [
  {
    q: 'What counts as a warehouse location?',
    a: "A location is any physical place you store components or finished goods — a warehouse, a storage room, a third-party facility. Bin/aisle areas within a single location don't count as additional locations.",
  },
  {
    q: 'What do I get during the free trial?',
    a: 'Full Pro-level access for 30 days — no credit card required. At the end of the trial, your account downgrades to the tier you selected at sign-up. You can add a card and upgrade at any time during or after the trial.',
  },
  {
    q: 'Can I change tiers after signing up?',
    a: 'Yes — you can upgrade or downgrade at any time. Upgrades take effect immediately. Downgrades take effect at the next billing cycle.',
  },
  {
    q: 'Is pricing per seat or per account?',
    a: 'Flat per-account pricing — no per-seat fees. Growth and above include unlimited team members.',
  },
  {
    q: 'Do you offer discounts for annual billing?',
    a: 'Annual billing saves you around 17% compared to paying month-to-month — put another way, paying monthly costs about 20% more. The toggle above shows you both options.',
  },
];

// The old page's own <title>/<meta description>, verbatim — not the reference
// layout's copy, which invents its own tagline ("Flat pricing. Unlimited
// users.") for the hero and never states this page's real head values at all.
const description =
  'Simple pricing for manufacturing teams. One price per tier, no per-seat fees, no usage meters. Start free for 30 days.';
// Old page's own twitter:description — identical to its og:description,
// both shorter than the meta description above (they drop the trailing
// "Start free for 14 days." clause). Base.astro's og:description still
// defaults to the long `description` (unchanged, not part of this fix);
// this only supplies the Twitter pair, which previously leaked the long
// description onto this page.
const twitterDescription =
  'Simple pricing for manufacturing teams. One price per tier, no per-seat fees, no usage meters.';

// The old page's own <script type="application/ld+json"> — a BreadcrumbList
// plus a FAQPage. The FAQPage is built from FAQS above (not retyped) so the
// visible <FaqList> and the markup can never drift apart.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://manuva.app/' },
      { '@type': 'ListItem', position: 2, name: 'Pricing', item: 'https://manuva.app/pricing' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base title="Pricing — Manuva" description={description} twitterDescription={twitterDescription} canonical="https://manuva.app/pricing" {schema}>
  {/* 1 · cobalt hero panel, inset on paper (was ink; navy came off the
      marketing site). Layout comes from the shared page-hero contract. */}
  <section class="site-hero site-pricing-hero">
    <div class="mv-wrap">
      <Panel field="cobalt" data-fold="cobalt" class="site-pricing-hero-panel">
        {/* old page's own eyebrow is a <div>, not a <span> — that's what isolates
            "Pricing" as its own short fragment on the old page (a boundary
            div followed by the h1), so this keeps the same tag, not the mv-eyebrow
            span pattern the home hero used for a differently-shaped old eyebrow. */}
        <div class="mv-eyebrow site-pricing-hero-eyebrow">Pricing</div>
        <h1 class="mv-display site-pricing-hero-title">Simple pricing for manufacturing teams</h1>
        <p class="site-pricing-hero-sub">
          One price per tier. No per-seat fees. No usage meters. Start free for 30 days — no credit card required.
        </p>
{/* This was <span>s inside an aria-hidden div with no script anywhere — a
            picture of a control. It looked interactive, invited a click and did
            nothing, and screen readers skipped it entirely. Now real buttons.

            Old page's two toggle <button>s sit inside one wrapping div with no
            boundary tag between them, so their text joins into one "Annual
            Monthly" run (real whitespace from the old file's own indentation) —
            the explicit {' '} reproduces that, since Astro drops the
            whitespace-only text node a raw space would leave. Buttons are not
            boundary tags either, so the join survives the change from spans.

            aria-pressed rather than a radiogroup: two mutually exclusive
            buttons where the pressed one is the current state is the simpler
            pattern, and it needs no roving tabindex. */}
        <div class="site-pricing-toggle">
          <div class="site-pricing-toggle-pill" role="group" aria-label="Billing period">
            <button type="button" class="site-pricing-toggle-btn site-pricing-toggle-on" data-billing="annual" aria-pressed="true">Annual</button>{' '}
            <button type="button" class="site-pricing-toggle-btn" data-billing="monthly" aria-pressed="false">Monthly</button>
          </div>
          <span class="site-pricing-save">Save ~17%</span>
        </div>
      </Panel>
    </div>
  </section>

  {/* 2 · paper plan cards — data, never a field behind it */}
  <section class="mv-section site-plans">
    <div class="mv-wrap">
      <PriceCards />
    </div>
  </section>

  {/* 3 · the accent, and a beat between four pale cards and a 43-row table.
      This is PriceCards' own "All plans include…" line, verbatim, promoted
      out of .mv-wrap so it can run full-bleed. */}
  <TrialStrip items={['All plans include a 30-day free trial · No credit card required']} />

  {/* 4 · paper matrix — data, never a field behind it */}
  <section class="mv-section site-matrix-section">
    <div class="mv-wrap">
      <FeatureMatrix />
    </div>
  </section>

  {/* 5 · mint FAQ. The page ran cobalt hero → paper → paper → paper → amber
      CTA: two fields on a long page, both of them chrome. The FAQ is the one
      block here that can take a field without breaking a loud-layer rule —
      the plan cards and the 43-row matrix are data, which never gets a colour
      field behind it. mint, so no two fields on the page share a hue and
      nothing touches the amber band below (CtaBand's own outer section is
      paper, so there is always paper between them). */}
  <Field field="mint" class="site-faq-section">
    <h2 class="mv-display">Frequently asked questions</h2>
    <FaqList items={FAQS} />
  </Field>

  {/* 6 · amber CTA. Heading is a verbatim quote, not an assembled tagline —
      the old page's own <meta name="description"> sentence (not body copy,
      but real old-page text all the same): "Simple pricing for manufacturing
      teams. One price per tier, no per-seat fees, no usage meters. Start
      free for 30 days." — the middle sentence is the one that fits a CTA.
      No secondActionHref: pricing.html has no closing cta-section at all
      (confirmed by reading the raw source, not assumed) — "Start free
      trial" alone, not a "Book a demo" invented to match every other
      page's pattern. */}
  <CtaBand
    field="amber"
    heading="One price per tier, no per-seat fees, no usage meters."
    body="30 days free with full Pro access. No credit card required."
  />
</Base>
<script>
  // Progressive enhancement. The server renders the annual figures — the old
  // page's own default toggle state, and what the copy-parity gate compares
  // against — so with this script absent the page is still correct, just not
  // switchable. Every value it needs is already in the DOM as a data attribute;
  // nothing is fetched and nothing re-renders.
  const toggle = document.querySelector<HTMLElement>('.site-pricing-toggle');
  if (toggle) {
    const buttons = [...toggle.querySelectorAll<HTMLButtonElement>('[data-billing]')];
    const save = toggle.querySelector<HTMLElement>('.site-pricing-save');

    const apply = (mode: string) => {
      for (const b of buttons) {
        const on = b.dataset.billing === mode;
        b.classList.toggle('site-pricing-toggle-on', on);
        b.setAttribute('aria-pressed', String(on));
      }
      document.querySelectorAll<HTMLElement>('[data-price-annual]').forEach((el) => {
        el.textContent = mode === 'monthly' ? el.dataset.priceMonthly! : el.dataset.priceAnnual!;
      });
      document.querySelectorAll<HTMLElement>('[data-note-annual]').forEach((el) => {
        el.textContent = mode === 'monthly' ? el.dataset.noteMonthly! : el.dataset.noteAnnual!;
      });
      // "or $119/mo billed monthly" is the alternative to whatever is showing,
      // so it is only true while annual is selected. Left visible on monthly it
      // would sit directly under a monthly price contradicting it.
      //
      // A class toggling `visibility: hidden`, not the `hidden` attribute:
      // `hidden` removes the box, so every card's CTA and feature list jumped
      // up ~43px on each toggle. visibility keeps the row reserved, which is
      // the same mechanism that now holds the Enterprise card in line with
      // the other three (see .site-plan-monthly).
      document.querySelectorAll<HTMLElement>('.site-plan-monthly').forEach((el) => {
        el.classList.toggle('is-muted', mode === 'monthly');
      });
      // The saving is the reason to pick annual; it is not a claim about the
      // monthly price.
      if (save) save.hidden = mode === 'monthly';
    };

    for (const b of buttons) {
      b.addEventListener('click', () => apply(b.dataset.billing!));
    }
  }
</script>

