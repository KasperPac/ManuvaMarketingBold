---
import Base from '../layouts/Base.astro';
import Video from '../components/site/Video.astro';
import Logo from '../components/ds/Logo.astro';
import { APP_URL, DOMAINS } from '../site';
// Frame count and the frame where the room turns calm, from the manifest the
// frame script reads, so the page and the frames cannot disagree.
import heroFrames from '../../scripts/hero-frames.json';

// Rebuilt on the new design (MVBOLD-17): full-field hero with a ghost
// numeral, the live marquee, the pinned stage of six shape-cut domain
// panels, and the closing field, with full motion. MVBOLD-29 replaced the
// hero with Dave's office and took the marquee off (below).
//
// The first pass of that rebuild kept only those blocks and dropped 46 of
// the page's 53 sentences with them — the explainer, the platform grid, the
// reports highlight, the onboarding steps, the integrations strip, the beta
// strip and the sectors row. "Keep latest content" was the instruction and
// that was a straight miss. All of it is back below, re-poured into the new
// design's own vocabulary (.sec / .split / .nlist) rather than the old
// components, but word for word.
//
// Content is this repo's latest, not the handoff's: the trial is 30 days and
// prices are AUD, both of which the handoff still carries at their older
// values (14 days, USD). Where the two disagree on fact, the repo wins.
//
// The hero's ghost numeral ("06", the six domains) came off in MVBOLD-29: the
// hero is now a claymation frame, and a giant numeral over it was noise. The
// stage panels keep their own numerals.
//
// Field rhythm, per the loud-layer rules — one full-bleed field per fold and
// never two touching:
//   Dave hero (cobalt field, never seen) → paper → paper → STAGE → paper →
//   amber → paper → ink → paper → flare outro
//
// The aqua beta band and the sectors row came off this page: both were
// full sections earning very little, and the tail was the part that read as
// crowded. Neither was deleted — the beta offer is on /pricing, where an
// offer belongs, and the sectors row joined /about's own "Who runs Manuva."
// section, which is the heading this row already borrowed its eyebrow from.
//
// The marquee came off in MVBOLD-29 (preview feedback): its constant drift
// right under the scrubbing hero was too distracting, so the page goes
// straight from the hero to the video. Every fact it carried is still stated
// on /features (yield %, BOM versioning and "roll back", unlimited users on
// Growth, real-time webhook sync) and the 30-day trial on /features and
// /pricing (checked 2026-10-01).

const HIGHLIGHT = {
  section: 'Reports & analytics',
  heading: "Operational intelligence, not last week's spreadsheet.",
  body: 'Ten built-in reports on stock, supplier performance, PO accuracy and dead stock — scoped to any date range, exported to CSV or PDF in a click.',
  href: '/features#reporting',
  feats: [
    'Stock on hand, valuation, movements and dead stock',
    'Supplier lead-time accuracy and PO variance, scored from your own data',
    'Every report exports to CSV or a print-ready PDF',
  ],
} as const;

const ONBOARDING = [
  { title: 'Connect Shopify', desc: 'Products, variants, and inventory levels stay in sync between Manuva and Shopify automatically.' },
  { title: 'Import your BOMs', desc: 'Upload a spreadsheet, or build the first one from a template. Nine minutes, typically.' },
  { title: 'Count once', desc: 'One stocktake session sets the baseline. Every movement after that is tracked for you.' },
  { title: 'Run a job', desc: 'Release a work order, allocate stock, and watch the floor scan against it.' },
] as const;

const INTEGRATIONS = ['Shopify', 'WooCommerce', 'Amazon', 'Etsy', 'Xero', 'QuickBooks', 'MYOB'];

// The old site's own #compare rows. They moved to /alternatives when the home
// page dropped that section; the new design puts a three-column comparison
// back on the home page as an ink .ctable, so they come home.
const COMPARE = [
  ['Pricing model', 'Flat per account', 'Per user, per month'],
  ['A 10-person team', '$249/mo', '$490/mo'],
  ['Yield % per BOM line', 'Included', 'Not offered'],
  ['BOM versioning & compare', 'Included', 'Not offered'],
  ['PO variance reporting', 'Included', 'Not offered'],
] as const;

// Annual per-month prices, for the SoftwareApplication offers below. AUD,
// matching /terms §4 ("Prices are stated in Australian Dollars") and the
// figures on /pricing.
const TIER_PRICES = [
  { name: 'Starter', price: '99' },
  { name: 'Growth', price: '249' },
  { name: 'Pro', price: '499' },
] as const;

const description =
  'Inventory, BOMs, work orders, and stock control — connected, live, and built for the floor. The simpler alternative to legacy MRP for Shopify manufacturers.';
const short =
  'Inventory, BOMs, work orders, and stock control — connected, live, and built for the floor.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://manuva.app/#org',
    name: 'Manuva',
    legalName: 'Pac Technologies Pty Ltd',
    url: 'https://manuva.app/',
    logo: { '@type': 'ImageObject', url: 'https://manuva.app/logo.png', width: 799, height: 179 },
    sameAs: [APP_URL],
    address: { '@type': 'PostalAddress', addressCountry: 'AU' },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'hello@manuva.app',
      availableLanguage: ['English'],
      url: 'https://manuva.app/about#contact',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://manuva.app/#website',
    url: 'https://manuva.app/',
    name: 'Manuva',
    publisher: { '@id': 'https://manuva.app/#org' },
  },
  {
    // Dropped in the first rebuild pass along with the page body. It is the
    // node that carries the product's category and its prices into a rich
    // result, so losing it is a live SEO regression, not cosmetic.
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Manuva',
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Manufacturing operations / MRP',
    operatingSystem: 'Web',
    description,
    url: 'https://manuva.app/',
    image: 'https://manuva.app/og-image.png',
    publisher: { '@id': 'https://manuva.app/#org' },
    // No aggregateRating/review — none exist in the source; inventing one
    // is both a project rule and a Google structured-data policy violation.
    offers: TIER_PRICES.map((t) => ({
      '@type': 'Offer',
      name: t.name,
      price: t.price,
      priceCurrency: 'AUD',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: t.price,
        priceCurrency: 'AUD',
        unitText: 'MONTH',
      },
      availability: 'https://schema.org/OnlineOnly',
      url: 'https://manuva.app/pricing',
    })),
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="Manuva — Manufacturing operations, finally simple"
  description={description}
  ogDescription={short}
  twitterDescription={short}
  canonical="https://manuva.app/"
  headInk="light"
  {schema}
>
  {/* Dave's office (MVBOLD-29). The first frame of the chaos-to-calm clip is
      plain markup: it is the LCP image and the whole hero for reduced-motion,
      Save-Data and no-JS visitors. Motion.astro pins .dave-pin and, after
      load, lays the clip itself over the still and scrubs it with the scroll.
      The hero carries only the tagline and the Manuva logo, which is painted
      onto the lime wall when the room turns calm (data-calm, in seconds of
      the clip) — .dave-scene is a box with the frame's own aspect, so the logo
      sits in the room's coordinates rather than the viewport's. The eyebrow,
      sub-copy and buttons are the band directly below, beside the video. */}
  <section class="hero dave mv-field-cobalt" data-calm={heroFrames.calm}>
    <div class="dave-pin">
      <div class="dave-scene">
        <picture>
          <source media="(max-aspect-ratio: 4/5)" srcset="/hero/dave/p.webp" width="500" height="1080" />
          <img
            src="/hero/dave/l.webp"
            width="1280"
            height="720"
            fetchpriority="high"
            alt="Claymation: Dave at his desk in a grey office full of spreadsheets and sticky notes. Scrolling tidies it into a calm, lime-green room with his feet up."
          />
        </picture>
        <div class="dave-logo"><Logo variant="lockup" fill decorative /></div>
      </div>
      <div class="dave-copy">
        <h1 class="disp">Less chaos. <span class="hl keep">More making.</span></h1>
      </div>
      <span class="dave-hint" aria-hidden="true"></span>
    </div>
  </section>

  {/* The hero's own copy, moved out of the scene so the scene can be seen,
      and the video beside it: the page goes straight from the hero to the
      video (preview feedback). Word for word what the hero carried; the
      buttons are the first thing after the scrub. */}
  <section class="sec hero-intro">
    <div class="split">
      <div style="display:grid;gap:18px;align-content:start;justify-items:start">
        <span class="eyebrow" style="opacity:.6">MRP for Shopify manufacturers</span>
        <p class="sub" style="color:var(--ink-muted);max-width:52ch">
          Manuva replaces the spreadsheets and legacy MRP your team is fighting with. Inventory, BOMs, work
          orders, and stock control — connected, live, and built for the floor.
        </p>
        <div class="row hero-intro-ctas">
          <a class="pill" href={APP_URL}>Start free</a>
          <a class="pill ghost" href="/about#contact">Book a demo</a>
        </div>
      </div>
      <div class="lead-media">
        <span class="eyebrow" style="opacity:.6">See it in 60 seconds</span>
        {/* The Dave ad (MANUVA-36). A facade, not an embed: the poster and
            button are static markup and nothing reaches youtube-nocookie.com
            until someone clicks. The poster is the ad's own end card, self-
            hosted. The caption carries "What Manuva actually does", the h2 of
            the section the explainer once replaced — the sentence stays on the
            page. */}
        <Video
          youtubeId="JXB4FgHRm_Y"
          poster="/video/dave-ad-poster.jpg"
          alt="Claymation: Dave relaxing with a mug of tea and his feet on his desk, beside the Manuva logo and the line Less chaos. More making."
          title="What Manuva actually does"
        />
      </div>
    </div>
  </section>

  {/* The stage's lead-in. This heading and sub used to head an eight-item
      platform grid below the stage — which restated the same six domains
      under the nine older area names, two of them pointing at anchors the
      panels already link to. You read the product's shape twice, the second
      time in a longer and less confident form, and it was the first of three
      numbered lists in a row. The grid is gone; its heading does the more
      useful job of introducing the stage instead of leaving it to arrive
      cold, and its four sentences that were not already on /features moved
      there. */}
  <section class="sec stage-lead">
    <span class="eyebrow" style="opacity:.6">The platform</span>
    <h2 class="disp">Everything your shop needs. Nothing it doesn't.</h2>
    <p class="sub" style="color:var(--ink-muted);max-width:58ch">
      One system covering the whole shop floor — from raw materials in to finished goods out. No modules to
      bolt on, no consultants to hire.
    </p>
    <a class="pill ink" href="/features" style="justify-self:start">Explore the full feature set &rarr;</a>
  </section>

  {/* The pinned stage. Six panels, one pin, each clipping in over the last on
      its own shape. Panel 0 carries no data-shape — it is the backdrop the
      other five land on. */}
  <section class="stage" aria-label="What Manuva does">
    <div class="pin">
      {DOMAINS.map((d, i) => (
        <a class={`panel mv-field-${d.field}`} href={`/features#${d.id}`} data-shape={i ? String(i - 1) : undefined}>
          <span class="pnum num" data-rate="26" aria-hidden="true" data-n={pad(i + 1)}></span>
          <span class="eyebrow" data-rate="88" style="opacity:.75">
            {pad(i + 1)} / {pad(DOMAINS.length)}
          </span>
          <h2 class="disp" data-rate="52">{d.name}</h2>
          <p class="pline" data-rate="70">{d.line}</p>
          <span class="more" data-rate="80">See {d.name.toLowerCase()}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="sec mv-field-amber">
    <div class="split">
      <div class="stick" style="display:grid;gap:18px">
        <span class="eyebrow" style="opacity:.7">Getting started</span>
        <h2 class="disp" style="font-size:min(clamp(40px,9vw,72px),calc(100cqi / var(--fit)))">Four steps and your floor is live.</h2>
        <p class="sub" style="opacity:.82">
          Nothing to install and nobody to book. Connect Shopify, bring in your BOMs, count once, then run a
          job. Most manufacturers finish in an afternoon.
        </p>
      </div>
      <ul class="nlist">
        {ONBOARDING.map((s, i) => (
          <li>
            <span class="i">{pad(i + 1)}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="split">
      <div class="stick" style="display:grid;gap:18px">
        <span class="eyebrow" style="opacity:.6">{HIGHLIGHT.section}</span>
        <h2 class="disp" style="font-size:min(clamp(40px,9vw,72px),calc(100cqi / var(--fit)))">{HIGHLIGHT.heading}</h2>
        <p class="sub" style="color:var(--ink-muted)">{HIGHLIGHT.body}</p>
        <a class="pill ink" href={HIGHLIGHT.href} style="justify-self:start">See every report &rarr;</a>
      </div>
      {/* Unnumbered. These are three facts, not three steps, and as a
          numbered list they were visually identical to the onboarding
          sequence above — two counted lists competing, only one of them
          actually a sequence. */}
      <ul class="nlist plain">
        {HIGHLIGHT.feats.map((f) => (
          <li><h3>{f}</h3></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec mv-field-ink">
    <div class="split">
      <div class="stick" style="display:grid;gap:20px">
        <span class="eyebrow" style="color:var(--field-amber)">Versus legacy MRP</span>
        <h2 class="disp">Priced for the shed, not the boardroom.</h2>
        <p class="sub" style="opacity:.75">
          Flat pricing, unlimited users from Growth up. Connect Shopify, import your BOMs, run your first job today.
        </p>
      </div>
      <div class="ctable" role="table" aria-label="Manuva compared with per-seat MRP">
        <div class="r h" role="row">
          <span role="columnheader"></span>
          <span class="eyebrow limechip" role="columnheader">Manuva</span>
          <span class="eyebrow" role="columnheader" style="opacity:.5">Per-seat MRP</span>
        </div>
        {COMPARE.map(([k, us, them]) => (
          <div class="r" role="row">
            <span class="k" role="rowheader">{k}</span>
            <span class="us" role="cell">{us}</span>
            <span class="them" role="cell">{them}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <p class="eyebrow" style="opacity:.6;margin:0">Integrates with the tools you already use</p>
    <ul class="logorow">
      {INTEGRATIONS.map((name) => <li>{name}</li>)}
    </ul>
  </section>

  <section class="outro mv-field-flare">
    <p class="disp">Run your first job today.</p>
    <p class="sub">30 days free with full Pro access. No credit card required.</p>
    <div class="row">
      <a class="pill white" href={APP_URL}>Start free</a>
      <a class="pill ghost" href="/pricing">See pricing</a>
    </div>
  </section>
</Base>
