---
import Base from '../layouts/Base.astro';
import Video from '../components/site/Video.astro';
import Icon from '../components/ds/Icon.astro';
import Field from '../components/site/Field.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { DOMAINS } from '../content/domains';

// Each shot gets its own full-bleed field, with its framing line on the paper
// section immediately above it. Before this, all three sat unframed in one
// 1,816px white run and the page carried no full-bleed field at all — the one
// route whose whole job is visual, styled like the routes that carry tables.
// /pricing and /alternatives/ are colourless for a real reason (the loud-layer
// rules forbid a field behind a data table or long-form copy); this page had no
// such constraint and no colour either.
//
// Hue order cobalt → amber → violet: none repeats, none is adjacent to another
// field (paper framing sections sit between all three), and none collides with
// the flare CtaBand that closes the page.
//
// The first band was ink until navy came off the marketing site entirely
// (author's call — navy stays in the app, where it is the substrate under one
// accent; here it was a third blue behind cobalt and aqua). Cobalt replaces it.
//
// That does mean cobalt now appears twice on this page: this band, and the
// Inventory accent chip further down. An earlier version of this comment
// claimed cobalt was "deliberately left out" so no band would share a hue with
// the chip nearest it — that reasoning died with ink, and the two are five
// sections and three fields apart, well outside anything the adjacency rule
// governs. Recording the change rather than quietly leaving the old claim.
const SHOTS = [
  {
    src: '/screen-dashboard.png',
    alt: 'Manuva dashboard overview with inventory value, fulfilment rate, and open orders',
    caption: 'Everything worth checking each morning, on one screen.',
    field: 'cobalt',
  },
  {
    src: '/screen-variant.png',
    alt: 'Manuva variant detail showing versioned bills of materials with cost comparison',
    caption: 'Two BOM versions, compared line by line.',
    field: 'amber',
  },
  {
    src: '/screen-components.png',
    alt: 'Manuva component selection modal with searchable parts library',
    caption: 'Every component, searchable, added in a click.',
    field: 'violet',
  },
];

// THE ONLY AUTHORED HEAD VALUES ON THE SITE. Every other route's title,
// description and og:/twitter: values are byte-identical to the old page.
// This route has no old counterpart, so these are written rather than moved
// and must be read as copy during review, not checked against a source.
//
// DESCRIPTION and the lede below were both rewritten post-review: the
// originals claimed "real screens" for all five domains listed by name.
// Ruling 1 (dropping Purchasing's and Audit's mismatched posters) made
// that false for two of the five — a reader hits the domains section one
// scroll down and finds no screen for either. Rewritten so "real screens"
// only names the three domains that have one; Purchasing and the audit
// trail are still named, just not as things you'll see a screen of.
//
// Task 6 (verification pass): DESCRIPTION originally joined both halves
// with ", plus" into one sentence — "real screens for inventory, BOMs and
// production, plus purchasing and the audit trail behind every change." A
// SERP snippet skim reads left to right with no visual break, so that
// clause reads as one flat list of five things under "real screens", the
// exact claim Ruling 1 already fixed once in the lede below (which uses a
// full stop for the same split, not a comma). Given a hard break here too,
// matching the lede's own second-sentence wording.
//
// Review round 3 (C1, Critical): "production" was still in the "real
// screens" clause here and in the lede below. Its own card poster was a
// crop of the dashboard's Orders queue (sales orders), not a production
// board — no screenshot of Production Planning exists among the three
// shots. Corrected the card (domains.ts) and this copy together: only
// inventory and BOMs have a real screen now.
const TITLE = 'Product Tour — Manuva';
const DESCRIPTION =
  'See Manuva in action — real screens for inventory and BOMs. Production, purchasing and the audit trail live here too.';

// BreadcrumbList — not in the brief's page skeleton (which passed no
// `schema` prop to <Base> at all), added because tests/unit/seo.test.ts
// runs two checks unconditionally across every entry in ALL_ROUTES: "every
// route emits at least one valid, parseable JSON-LD block" and "every route
// except home carries a BreadcrumbList whose last crumb is its own
// canonical URL". Without this, both fail the moment /product joins
// ALL_ROUTES. Same shape as features.astro's own schema, the simplest
// precedent (no FAQ/pricing data of its own to carry).
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://manuva.app/' },
      { '@type': 'ListItem', position: 2, name: 'Product', item: 'https://manuva.app/product' },
    ],
  },
];
---
<Base
  title={TITLE}
  description={DESCRIPTION}
  twitterDescription={DESCRIPTION}
  canonical="https://manuva.app/product"
  {schema}
>
  <section class="mv-section site-product-hero">
    <div class="mv-wrap">
      <h1 class="mv-display">The product. Not a pitch.</h1>
      <p class="site-product-lede">
        Real screens of inventory and bills of materials, exactly as they run. Production, purchasing and the
        audit trail live here too, underneath every change.
      </p>
    </div>
  </section>

  {/* The screenshots, at a size where the interface is legible. This is where
      the dashboard belongs — someone here has chosen to look at the product.

      Each shot is a full-bleed field carrying only the image; its framing line
      sits on the paper section above it, so the line introduces the screen it
      describes rather than trailing the one before. That also guarantees paper
      between every pair of fields, which is the rule the home page's own
      ink/aqua adjacency broke. The <img> keeps its shadow and radius so it
      still reads as a screen sitting on the field rather than a texture
      bleeding into it. */}
  {SHOTS.map((s, i) => (
    <>
      <section class="mv-section site-product-framing">
        <div class="mv-wrap"><p class="site-product-framing-line">{s.caption}</p></div>
      </section>
      <Field field={s.field}>
        <figure class="site-product-shot">
          <img src={s.src} alt={s.alt} width="2080" height="1090" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        </figure>
      </Field>
    </>
  ))}

  {/* Five domain cards. Each blurb is lifted from the source named in its
      `source` field — nothing composed. A card shows its video when one is
      uploaded and its still until then; a card with no matching screenshot
      (Production, Purchasing, Audit) shows no image at all rather than a
      proxy one — author's ruling, post-review: a screenshot that doesn't
      depict what its heading claims is the visual equivalent of an
      invented blurb, the exact failure class this project has refused
      three times now (Production's own card shipped a sales-orders crop
      under this same rule until review round 3 caught it — see
      domains.ts). No
      caption on any card either — the heading already names the domain;
      `title` is still passed to Video for the play button's accessible
      name (relevant once a real category video exists), `caption={false}`
      just stops it from also rendering as visible text under the poster.
      data-fold={d.field}, in addition to the inline background/color style:
      not in the brief's literal markup, but required for the card's own ink
      to resolve correctly. Two concrete failures without it: (1) --on-flare
      defaults to #FFFFFF (3.33:1 on flare, fails AA) and only the existing
      [data-fold="flare"] rule (site.css, primitives section) redeclares it
      to #141413 (5.54:1) — Tile.astro hits this same gap and works around it
      with a manual href-scoped override because it has no data-fold hook;
      this card does have one, so it gets the real fix instead of another
      one-off override. (2) Video's own .site-video-caption is opacity:.72
      by default and only un-mutes under [data-fold] — moot now that no card
      shows a caption, but the fix stays: any future field-scoped Video text
      here (the alt text, the caption if a domain's copy ever needs one)
      inherits the same correct behaviour for free. */}
  <section class="mv-section site-product-domains">
    <div class="mv-wrap">
      <h2 class="mv-display">Five systems. One account.</h2>
      <div class="mv-cols-3">
        {DOMAINS.map((d) => (
          <article class="site-domain-card">
            {/* The card is paper now; the hue survives as the accent chip
                behind the icon. Five saturated cards were the page's only colour
                event, arriving all at once as a swatch grid — with three field
                bands above them that reads as noise, and it also put five
                different hues in one viewport, which nothing else on the site
                does at this size.

                The chip is still a real field/ink pair rather than the hue used
                as a graphic on paper, so the loud-layer rule holds and the flare
                ink override keeps working — hence data-fold on the chip, not on
                the article: --on-flare defaults to #FFFFFF (3.33:1) and only
                [data-fold="flare"] redeclares it to #141413. */}
            <span class="site-domain-accent" data-fold={d.field} style={`background:var(--field-${d.field});color:var(--on-${d.field})`}>
              <Icon name={d.icon} size={22} />
            </span>
            <h3 class="site-domain-name">{d.name}</h3>
            <p class="site-domain-blurb">{d.blurb}</p>
            {d.poster && <Video poster={d.poster} alt={d.posterAlt} youtubeId={d.youtubeId} title={d.name} caption={false} />}
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* heading quotes the hero h1 above verbatim — same convention as the home
      page's own closing CtaBand, which quotes its lede. This page's copy is
      authored, so quoting one of its own lines rather than composing a
      second is the established way to satisfy "CtaBand's heading must quote
      a real sentence that exists on the page, exactly". */}
  <CtaBand
    field="flare"
    heading="The product. Not a pitch."
    body="14 days free with full Pro access. No credit card required."
  />
</Base>
