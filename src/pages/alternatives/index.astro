---
import Base from '../../layouts/Base.astro';
import { APP_URL } from '../../site';

// Rebuilt on the new design (MVBOLD-23). It was the last page besides /about
// still on the pre-rebuild components, which is also why its header looked
// wrong: the old .site-hero centres its content, so the logo sat alone on the
// left gutter with nothing beneath it to line up against.
//
// Motion: one moment — a single shape cut into the comparison, the same
// ration the two pages it points at get. It takes the blade (shape 4) since
// katana uses the diagonal slab and mrpeasy the column wipe, so no two pages
// in this family animate identically.
//
// This route exists to fix a real navigation gap: nav "Compare" pointed at
// /alternatives/katana specifically, so /alternatives/mrpeasy had no
// primary-nav path at all. Picking one of two competitor pages to be
// "Compare" was always arbitrary; this is the parent both were missing.
//
// The comparison table is the old home page's own #compare section, carried
// here verbatim when that section came off the landing page — same rows, same
// intro, same caption, same footnote links.
const COMPARE_ROWS = [
  ['Real-time inventory', 'yes', 'yes', 'Batch sync', 'no'],
  ['BOM versioning', 'yes', 'Manual', 'no', 'no'],
  ['Delivery receipts / goods-in', 'yes', 'yes', 'yes', 'In a tab'],
  ['Warehouse bin locations', 'yes', 'no', 'Add-on', 'no'],
  ['Shopify integration', 'yes', 'yes', 'no', 'no'],
  ['Staff capacity planning', 'yes', 'no', 'Basic', 'no'],
  ['Cost management', 'yes', 'Basic', 'yes', 'no'],
  ['Setup time', 'Days', 'Days–weeks', 'Weeks', 'Hours'],
] as const;

const COLUMNS = ['Manuva', 'Katana', 'MRPeasy', 'Spreadsheets'] as const;

// Each card's blurb is the target page's own <meta description>, verbatim —
// not a written summary. Both are already reviewed, ranking copy.
const COMPARISONS = [
  {
    href: '/alternatives/katana',
    field: 'violet' as const,
    name: 'Manuva vs Katana',
    blurb:
      'Katana alternative for Shopify manufacturers. Compare pricing, BOM versioning, bin locations, and capacity planning — Manuva starts at $99/mo with unlimited floor users.',
  },
  {
    href: '/alternatives/mrpeasy',
    field: 'flare' as const,
    name: 'Manuva vs MRPeasy',
    blurb:
      'MRPeasy alternative built for Shopify product brands. Compare per-seat pricing, setup time, real-time sync, and shop-floor usability against Manuva at $99/mo.',
  },
];

// Authored head values — this route has no old counterpart, so both need
// reading as copy at review rather than checking against a source.
const TITLE = 'Manuva vs the alternatives — MRP comparisons';
const DESCRIPTION =
  'Compare Manuva against Katana, MRPeasy, and spreadsheets — pricing, BOM versioning, bin locations, capacity planning, and setup time, side by side.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://manuva.app/' },
      { '@type': 'ListItem', position: 2, name: 'Compare', item: 'https://manuva.app/alternatives' },
    ],
  },
];

// How many capabilities the spreadsheet column simply does not have. Counted,
// not asserted — the ghost numeral has to be a figure the page can prove.
const gaps = COMPARE_ROWS.filter((r) => r[4] === 'no').length;
---
<Base
  title={TITLE}
  description={DESCRIPTION}
  twitterDescription={DESCRIPTION}
  canonical="https://manuva.app/alternatives"
  current="/alternatives"
  headInk="light"
  {schema}
>
  {/* aqua: the two cards below are violet and flare and the closing band is
      lime, so this is the one field on the page that repeats nothing. */}
  <section class="hero mv-field-aqua">
    <span class="ghostnum num" aria-hidden="true" data-n="vs"></span>
    <span class="eyebrow" style="opacity:.8">Compare</span>
    <h1 class="disp">Manuva vs <span class="hl">the alternatives</span></h1>
    <p class="sub" style="opacity:.9;max-width:46ch">
      Honest, dated comparisons against the tools Shopify manufacturers actually evaluate.
    </p>
    <div class="row">
      <a class="pill ink" href={APP_URL}>Start free</a>
      <a class="pill ghost" href="/pricing">See pricing</a>
    </div>
  </section>

  <section class="sec">
    <div style="display:grid;gap:12px">
      <span class="eyebrow" style="opacity:.6">Head to head</span>
      <h2 class="disp">Two comparisons, both current.</h2>
    </div>
    <div class="pgrid">
      {COMPARISONS.map((c) => (
        <article class={`pcard mv-field-${c.field}`}>
          <h3 class="disp" style="font-size:clamp(28px,4.4vw,38px);margin:0">{c.name}</h3>
          <p style="margin:0;font-size:16px;line-height:1.5;opacity:.9">{c.blurb}</p>
          <a class="pill ghost" href={c.href} style="justify-self:start">Read the full comparison &rarr;</a>
        </article>
      ))}
    </div>
  </section>

  {/* The page's one pinned moment. */}
  <section class="mv-field-ink" id="compare">
    <div class="intro" data-from="paper" data-shape="4">
      <div class="ipin">
        <div class="cut mv-field-ink">
          <span class="pnum num" data-rate="30" aria-hidden="true" data-n={String(gaps).padStart(2, '0')}></span>
          <span class="eyebrow" data-rate="70" style="color:var(--field-lime)">Why Manuva</span>
          <h2 class="disp" data-rate="50">Built for the floor, not for the demo.</h2>
          {/* Not a repeat of the paragraph below it — that copy is carried
              verbatim and stays there. This is the figure the numeral shows,
              counted off the table rather than asserted. */}
          <p class="pline" data-rate="90">{gaps} things a spreadsheet can't do.</p>
        </div>
      </div>
    </div>
    <div class="wrap" style="padding-bottom:96px;display:grid;gap:24px">
      <p class="sub" style="opacity:.8;font-size:16px;max-width:62ch">
        Other tools either started as accounting software or as Trello-for-factories. Manuva was built from day
        one for the way real shops run production.
      </p>
      {/* A real ARIA table. Both verdicts used to be aria-hidden glyphs, so a
          row came back as `"Real-time inventory" | "" | "" | "Batch sync" | ""`
          — Manuva's yes and a competitor's no were indistinguishable and the
          table read as though nobody had anything. The verdict is a word now,
          so it carries itself and needs no icon label at all. */}
      <div class="ctable wide" role="table" aria-label="Feature comparison: Manuva vs competitors">
        <div class="r h" role="row">
          <span role="columnheader"></span>
          {COLUMNS.map((c, i) => (
            i === 0
              ? <span class="eyebrow limechip" role="columnheader">{c}</span>
              : <span class="eyebrow" role="columnheader" style="opacity:.5">{c}</span>
          ))}
        </div>
        {COMPARE_ROWS.map(([name, ...verdicts]) => (
          <div class="r" role="row">
            <span class="k" role="rowheader" style="opacity:.85">{name}</span>
            {verdicts.map((v, i) => (
              <span
                class={i === 0 ? 'us' : 'them'}
                role="cell"
                data-verdict={i === 0 ? undefined : v === 'yes' ? 'yes' : v === 'no' ? 'no' : 'partial'}
              >{v === 'yes' ? 'Yes' : v === 'no' ? 'No' : v}</span>
            ))}
          </div>
        ))}
      </div>
      <p class="sub" style="opacity:.7;font-size:15px;max-width:62ch">
        Competitor data based on publicly available information, last checked May 2026. Check each vendor's
        current site before you decide.
      </p>
    </div>
  </section>

  <section class="sec" style="padding-block:40px">
    <span class="eyebrow" style="opacity:.6">See full comparison</span>
    <nav class="related" aria-label="Related pages">
      <a href="/alternatives/katana">Manuva vs Katana</a>
      <a href="/alternatives/mrpeasy">Manuva vs MRPeasy</a>
      <a href="/features">Full feature list</a>
      <a href="/pricing">Pricing &amp; plans</a>
    </nav>
  </section>

  <section class="outro mv-field-lime">
    <p class="disp">See Manuva in action.</p>
    <p class="sub">30-day free trial, full Pro access. No credit card required. Set up in a day.</p>
    <div class="row">
      <a class="pill ink" href={APP_URL}>Start free</a>
      <a class="pill ghost" href="/about#contact">Book a demo</a>
    </div>
  </section>
</Base>
