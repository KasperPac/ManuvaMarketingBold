---
import Compare from '../../layouts/Compare.astro';

// Rebuilt on the new design (MVBOLD-17). Motion: one moment — a single shape
// cut into the feature comparison. Layout and behaviour come from
// layouts/Compare.astro; everything here is this page's own content, carried
// across from the previous build rather than retyped.
//
// The reference's FAQ answers are stubs marked TODO. These are the real ones.
//
// This page argues the per-seat maths rather than listing gaps, so its second
// section carries the seat table instead of a numbered list. The first pass
// of this rebuild dropped the table entirely — it is the page's whole case.

const SEAT_HEAD = [
  'Team size',
  'MRPeasy Professional (per-user)',
  'Manuva Growth (flat)',
  'Manuva Pro (flat)',
] as const;

const SEAT_ROWS = [
  ['3 users', '~$147/mo', ['$249/mo', null], ['$499/mo', null]],
  ['5 users', '~$245/mo', ['$249/mo', null], ['$499/mo', null]],
  ['10 users', '~$490/mo', ['$249/mo', '−$241'], ['$499/mo', null]],
  ['15 users', '~$735/mo', ['$249/mo', '−$486'], ['$499/mo', '−$236']],
  ['25 users', '~$1,225/mo', ['$249/mo', '−$976'], ['$499/mo', '−$726']],
] as const;

// The 4th element is the OLD PAGE's own verdict class for the MRPeasy column
// (yes/no/partial), carried as sourced data, not re-derived from the verdict
// text. A text-matching ternary shipped once before and silently softened
// MRPeasy's own "Per user" pricing to an amber "partial", and sharpened its
// "15 days" free trial — a true positive fact about MRPeasy — to "partial"
// too, making the two compare pages disagree with each other on the
// identical "Pricing model → Per user" claim.
const MATRIX = [
  ['Pricing model', 'Flat per account', 'Per user', 'no'],
  ['Native Shopify webhook sync', 'Yes', 'Batch connector', 'partial'],
  ['BOM versioning with comparison', 'Yes', 'No', 'no'],
  ['Yield % per BOM line', 'Yes', 'Limited', 'partial'],
  ['Capacity planning with staff costing', 'Yes (Pro)', 'Basic', 'partial'],
  ['PO variance reporting', 'Yes', 'No', 'no'],
  ['Lead-time accuracy by supplier', 'Yes', 'Limited', 'partial'],
  ['Multi-warehouse + bin locations', 'Yes (Growth)', 'Yes', 'yes'],
  ['Financial profitability dashboard', 'Yes (Pro)', 'No', 'no'],
  ['Free trial', '30 days, full Pro', '15 days', 'yes'],
  ['Setup time', 'Hours to days', 'Days to weeks', 'partial'],
] as const;

const ADDS = [
  {
    title: 'Native Shopify webhook sync',
    body: 'Orders, products, and inventory move in real time. Place an order in Shopify → Manuva allocates components and cascades to production in seconds. No batch jobs, no manual refresh, no overnight catch-up.',
  },
  {
    title: 'BOM versioning with diff',
    body: 'Every change to a bill of materials is captured as a numbered version with timestamp. Compare any two versions side-by-side to see added, removed, and changed components with cost and margin impact. Roll back with one click.',
  },
  {
    title: 'Flat-rate unlimited users',
    body: 'Growth at $249/mo and Pro at $499/mo include unlimited users — office staff and shop floor. No seat audit at renewal. No surprise bill when you hire. Predictable economics through every growth stage.',
  },
] as const;

const FAQS = [
  {
    q: 'Does Manuva have a per-user pricing tier like MRPeasy?',
    a: 'No. Manuva uses flat per-account pricing across every tier. The Starter plan covers up to 3 users; Growth and Pro include unlimited users — office and shop floor — at $249/mo and $499/mo respectively. There is no scenario where adding a team member raises your bill.',
  },
  {
    q: "How does Manuva's Shopify sync compare to MRPeasy?",
    a: 'Manuva uses Shopify webhooks for real-time sync: an order placed in Shopify is allocated and cascades to production orders within seconds. MRPeasy provides a Shopify connector, but stock and order sync runs on a batch schedule rather than instantly per webhook. For brands where production capacity is tight or inventory is shared across channels, the latency difference matters.',
  },
  {
    q: 'Can I migrate from MRPeasy to Manuva without downtime?',
    a: "Yes. Export your components, BOMs, suppliers, purchase orders, and stock balances from MRPeasy as CSV. Run Manuva alongside MRPeasy during the 30-day trial — switch your Shopify webhook from MRPeasy to Manuva only when you're satisfied. The Manuva team will handle the data import for you on Growth and above.",
  },
  {
    q: 'What MRPeasy features does Manuva not yet have?',
    a: "MRPeasy ships some manufacturing-resource-planning capabilities aimed at industrial operations that Manuva does not currently match — for example, deeper MRP run scheduling, longer-horizon material requirements planning, and certain accounting integrations targeted at MRPeasy's broader industrial customer base. Manuva's focus is product brands selling through Shopify and adjacent channels; for that profile, Manuva's BOM versioning, capacity planning with staff costing, and PO variance reporting cover the gaps that matter most.",
  },
] as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://manuva.app/' },
      { '@type': 'ListItem', position: 2, name: 'Alternatives', item: 'https://manuva.app/alternatives' },
      { '@type': 'ListItem', position: 3, name: 'MRPeasy', item: 'https://manuva.app/alternatives/mrpeasy' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Compare
  title="MRPeasy Alternative for Shopify Manufacturers — Manuva"
  description="MRPeasy alternative built around flat-rate pricing, native Shopify webhook sync, and BOM versioning. See how Manuva compares — 30-day free trial."
  ogDescription="MRPeasy alternative built around flat-rate pricing, native Shopify webhook sync, and BOM versioning. See how Manuva compares."
  twitterDescription="MRPeasy alternative built around flat-rate pricing, native Shopify webhook sync, and BOM versioning."
  canonical="https://manuva.app/alternatives/mrpeasy"
  them="MRPeasy"
  otherHref="/alternatives/katana"
  otherLabel="Katana"
  heroField="flare"
  cutShape={4}
  h1Lead="MRPeasy alternative:"
  h1Highlight="flat-rate manufacturing software for growing teams"
  heroLede="MRPeasy is broad — it serves industrial manufacturers, distributors, and product brands alike. If you're a Shopify-first brand running production, that breadth shows up as per-seat pricing, batch Shopify sync, and a feature set you're paying for but mostly don't use. Manuva is the focused alternative: native Shopify webhooks, flat-rate pricing, capacity planning built for product brands."
  gapsEyebrow="The per-seat problem"
  gapTitle="MRPeasy pricing scales with headcount, not capability"
  gapBody="MRPeasy advertises four tiers — Starter, Professional, Enterprise, Unlimited — each priced per user, per month. The unit economics work fine for a 3-person operation. They get progressively painful as the team grows. The shop floor is where most manufacturing teams add headcount, and you don't want a software bill that scales linearly with it."
  seatHead={SEAT_HEAD}
  seatRows={SEAT_ROWS}
  seatFoot="MRPeasy Professional list pricing as of May 2026 (~$49/user/month billed annually, their published USD list price). Check MRPeasy's current site before you decide. Manuva's Growth and Pro tiers include unlimited users on all plans above Starter."
  calloutIn="gaps"
  priceCalloutLead="The break-even is around 5 users."
  priceCallout="Below that, MRPeasy can be cheaper. From the 5-user mark onward, Manuva Growth wins on flat-rate alone — and you still haven't priced in capacity planning, BOM versioning, or the financial profitability dashboard."
  matrix={MATRIX}
  matrixTitle="Manuva vs MRPeasy — feature comparison"
  matrixBody="The areas where the two products diverge most sharply for a Shopify-first manufacturer."
  matrixNote="Comparison based on MRPeasy's publicly documented feature set as of May 2026. We re-check competitor claims quarterly."
  addsEyebrow="What Manuva adds"
  addsTitle="What you get that MRPeasy doesn't offer in this segment"
  addsBody="Three capabilities where Manuva is built specifically for Shopify-first product brands."
  adds={ADDS}
  faqs={FAQS}
  ctaHeading="Try Manuva free for 30 days."
  ctaBody="Full Pro access. No credit card required. Run it alongside MRPeasy during the trial — switch your Shopify webhook only when you're satisfied."
  {schema}
/>
