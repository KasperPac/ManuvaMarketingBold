---
import Compare from '../../layouts/Compare.astro';

// Rebuilt on the new design (MVBOLD-17). Motion: one moment — a single shape
// cut into the feature comparison. Layout and behaviour come from
// layouts/Compare.astro; everything here is this page's own content, carried
// across from the previous build rather than retyped.
//
// The reference's FAQ answers are stubs marked TODO. These are the real ones.

// Verbatim from the old page's "Where Katana stops short" section. The first
// pass of this rebuild dropped all five of these — the largest block of copy
// on the page, and the part that does the ranking work. They are back.
const GAPS = [
  {
    lead: 'No BOM versioning or side-by-side comparison.',
    body: "When a component changes — a supplier swap, a price update, a recipe revision — Katana overwrites the BOM. There's no version history, no rollback, and no way to see what the cost or margin impact of a change actually was. Manuva treats every BOM change as a numbered version with full diff and one-click rollback.",
  },
  {
    lead: 'No yield % per BOM line.',
    body: "Real manufacturing has scrap. Cutting fabric, sanding wood, pouring chemistry — every process consumes more material than the nominal quantity. Katana's BOM math assumes 1:1 consumption, so purchasing and production planning systematically under-order. Manuva lets you set yield per component so material requirements reflect what you actually consume.",
  },
  {
    lead: 'Per-user pricing that punishes shop-floor growth.',
    body: "Katana charges per user. A 10-person operation — three office staff, six on the floor, one supervisor — hits multi-hundred-dollar monthly bills before you've added a single advanced feature. Manuva charges per account at $499/mo flat for the full Pro tier, with unlimited users from Growth ($249/mo).",
  },
  {
    lead: 'No capacity planning at any tier.',
    body: "Katana doesn't model who works in which department, what hours they're available, or what each production run actually cost in labour. Manuva's Pro plan ships departments, staffing levels, capacity vs load reporting, and full staff costing for the same flat price.",
  },
  {
    lead: 'No PO variance or lead-time accuracy reporting.',
    body: "Did your supplier deliver what you ordered, on time, at the agreed price? Katana doesn't surface this. Manuva measures promised vs actual on every purchase order — by supplier, component, and time window — so renegotiations happen from data, not gut feel.",
  },
] as const;

// The 4th element is the OLD PAGE's own verdict class for the Katana column
// (yes/no/partial), carried across as sourced data rather than re-derived
// from the verdict text. A text-matching ternary shipped once before and
// silently recoloured Katana's own "14 days" free trial — a TRUE, POSITIVE
// fact about Katana — as a red "no" verdict, because the text isn't the
// literal string "Yes".
const MATRIX = [
  ['BOM versioning with comparison', 'Yes', 'No', 'no'],
  ['Yield % per BOM line', 'Yes', 'No', 'no'],
  ['Capacity planning', 'Yes (Pro)', 'No', 'no'],
  ['Staff costing per production run', 'Yes (Pro)', 'No', 'no'],
  ['Shopify webhook sync (real-time)', 'Yes', 'Yes', 'yes'],
  ['Multi-warehouse + bin locations', 'Yes (Growth)', 'Limited', 'partial'],
  ['PO variance reporting', 'Yes', 'No', 'no'],
  ['Lead-time accuracy by supplier', 'Yes', 'No', 'no'],
  ['Financial profitability dashboard', 'Yes (Pro)', 'No', 'no'],
  ['Pricing model', 'Flat per account', 'Per user', 'no'],
  ['Free trial', '30 days, full Pro', '14 days', 'yes'],
] as const;

// Both price ladders, verbatim. Dropped in the first pass, restored here.
const PRICE_COLS = [
  {
    name: 'Katana',
    sub: 'Per-user pricing. Numbers scale linearly with team size.',
    rows: [
      ['1 user', '~$179/mo'],
      ['5 users', '~$359/mo'],
      ['10 users', '~$629/mo'],
      ['15 users', '~$899/mo'],
    ],
    callout:
      'Advanced manufacturing features and additional integrations are gated behind higher tiers. Total cost climbs further as those are added.',
  },
  {
    name: 'Manuva',
    sub: 'Flat per account. Unlimited users from Growth.',
    featured: true,
    rows: [
      ['Starter — up to 3 users', '$99/mo'],
      ['Growth — unlimited users', '$249/mo'],
      ['Pro — full capacity planning', '$499/mo'],
      ['Enterprise — SSO, multi-site', 'Custom'],
    ],
    calloutLead: 'Unlimited users from Growth — no seat charges, ever.',
    callout:
      'Manuva pricing in AUD, billed annually. Monthly add ~20%. Katana figures are their published USD list price.',
  },
] as const;

const ADDS = [
  {
    title: 'BOM versioning + side-by-side comparison',
    body: 'Every change captured as a numbered version. Compare any two versions to see added, removed, and changed components with cost and margin delta. Roll back with one click. The audit trail every regulated or growing manufacturer eventually needs.',
  },
  {
    title: 'Yield % per component line',
    body: 'Set scrap allowances per component. Material requirements automatically reflect real consumption, not theoretical 1:1 math. Stops the systematic under-purchasing that plagues teams running Katana at scale.',
  },
  {
    title: 'Capacity planning with staff costing',
    body: 'Model departments, staffing levels, and hours available. Track actual vs planned time per production order. Roll labour costs into unit economics. Available on Pro at the same flat rate as everything else — no per-user surcharge.',
  },
] as const;

const FAQS = [
  { q: 'Is Manuva a direct replacement for Katana?', a: 'Yes for the core workflows: inventory, BOMs, production orders, purchasing, and Shopify sync. Manuva covers everything a small-to-mid-size Shopify-first manufacturer relies on Katana for, plus capabilities Katana does not ship at any tier — BOM versioning with side-by-side comparison, yield % per component, BOM templates, capacity planning, and PO variance reporting.' },
  { q: 'Can I import my data from Katana?', a: 'Yes. CSV import is available for components, BOMs, suppliers, purchase orders, and stock balances. Most teams export from Katana, clean up the data, and import in under a day. For larger or more complex migrations, the Manuva team will run the import for you as part of onboarding on Growth and above.' },
  { q: 'Does Manuva work with Shopify the same way Katana does?', a: 'Manuva uses Shopify webhooks for real-time sync. When an order is placed in Shopify, Manuva allocates inventory and cascades to production orders within seconds — no nightly batch import, no manual refresh. Product and variant catalogues stay in sync automatically, and inventory levels flow back to Shopify as production completes.' },
  { q: 'What happens to my Katana account if I switch?', a: "Run them in parallel during your 30-day Manuva trial — disconnect Katana's Shopify webhook before connecting Manuva's, so only one system is writing to Shopify at a time. Once you're satisfied, cancel Katana directly with their billing. Manuva will not lock you in: you can export all your data from Manuva at any time, on any plan." },
] as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://manuva.app/' },
      { '@type': 'ListItem', position: 2, name: 'Alternatives', item: 'https://manuva.app/alternatives' },
      { '@type': 'ListItem', position: 3, name: 'Katana', item: 'https://manuva.app/alternatives/katana' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Compare
  title="Katana Alternative for Shopify Manufacturers — Manuva"
  description="Looking for a Katana alternative with BOM versioning, flat-rate pricing, and real Shopify sync? See how Manuva compares — 30-day free trial, no credit card."
  ogDescription="Looking for a Katana alternative with BOM versioning, flat-rate pricing, and real Shopify sync? See how Manuva compares."
  twitterDescription="Looking for a Katana alternative with BOM versioning, flat-rate pricing, and real Shopify sync? See how Manuva compares."
  canonical="https://manuva.app/alternatives/katana"
  them="Katana"
  otherHref="/alternatives/mrpeasy"
  otherLabel="MRPeasy"
  heroField="violet"
  cutShape={1}
  h1Lead="Katana alternatives for Shopify manufacturers:"
  h1Highlight="why teams switch to Manuva"
  heroLede="Katana is a good starting point. Manuva is where you go when you've outgrown it — when your BOMs need versioning, your team has hit per-user pricing, or you need capacity planning that a real shop floor can run on. Built for Shopify-first product brands, priced flat, set up in a day."
  gapsEyebrow="Where Katana stops short"
  gapTitle="What Katana doesn't do that Shopify manufacturers need"
  gapBody="Katana covers the basics — inventory, simple BOMs, work orders, and Shopify sync. As your operation matures, five gaps tend to drive teams to evaluate alternatives. Each item below is based on Katana's publicly documented feature set as of May 2026. Check Katana's current site before you decide."
  gaps={GAPS}
  matrix={MATRIX}
  matrixTitle="Manuva vs Katana — feature comparison"
  matrixBody="Quick reference for the capabilities most teams ask about when evaluating a switch."
  matrixNote="Comparison based on Katana's publicly documented feature set as of May 2026. We re-check competitor claims quarterly."
  priceTitle="What you actually pay."
  priceBody="Both products advertise an entry tier under $200/month, but the trajectories diverge fast. Katana scales with headcount. Manuva scales with capability."
  priceCols={PRICE_COLS}
  priceCalloutLead="At 10 users:"
  priceCallout="Katana's per-user tiers typically work out to ~$600/mo or higher before advanced manufacturing add-ons. Manuva Pro is $499/mo flat — and you get capacity planning, staff costing, and the financial profitability dashboard included. Confirm current Katana pricing on their site before locking in a budget."
  addsEyebrow="What Manuva adds"
  addsTitle="What you get that Katana doesn't offer at any price"
  addsBody="Three categories where Manuva ships meaningful functionality Katana does not."
  adds={ADDS}
  faqs={FAQS}
  ctaHeading="Try Manuva free for 30 days."
  ctaBody="Full Pro access. No credit card required. Run it in parallel with Katana — switch your Shopify webhook when you're satisfied."
  {schema}
/>
