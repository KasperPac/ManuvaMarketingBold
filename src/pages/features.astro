---
import Base from '../layouts/Base.astro';
import { APP_URL, DOMAINS } from '../site';

// Rebuilt on the new design (MVBOLD-17). Full motion: every domain enters on
// its own shape cut, the chip bar tracks which one you are in, and the page
// closes on lime.
//
// The nine sections the previous build carried are condensed into the design's
// six domains. Nothing was dropped — all 66 features moved across, generated
// from the old GROUPS array rather than retyped:
//
//   Inventory  11   <- inventory
//   Purchasing  7   <- purchasing
//   Production  7   <- BOMs & manufacturing
//   Sales      11   <- orders & fulfilment + Shopify & platform
//   Planning   12   <- production planning + capacity & team
//   Reporting  18   <- costing & profitability + reports & analytics
//
// Tier badges are kept and still link to /pricing. The reference nlist has no
// slot for them, but which plan a feature needs is content, and 36 of them
// dead-ended before MVBOLD-16 gave them somewhere to go.
// The nine source areas' own framing — heading, intro and the "unique to
// Manuva" call-out where the old page had one. The first pass of this rebuild
// condensed nine sections into six domains and dropped all of this with them:
// 9 headings, 9 intros and 5 differentiators, which is the copy that actually
// argues the product. It is back, verbatim, keyed to the domain that absorbed
// each area. A domain with two source areas shows both, in the old order.
// `carried` holds a sentence that used to live in the home page's platform
// grid. That grid restated the stage and was cut, so the four of its bodies
// that were not already on this page came here rather than leaving the site.
const AREAS: Record<string, { eyebrow: string; heading: string; intro: string; carried?: string; diff?: { lead: string; text: string } }[]> = {
  inventory: [
    {
      eyebrow: 'Inventory',
      heading: 'Stock counts you can actually trust.',
      intro: 'Every movement logged. Every adjustment tracked. Bin-level locations mean nothing gets lost on the floor.',
      carried: 'From raw materials to finished goods — live stock counts, production orders, manufacturing plans, and stocktakes. Everything that keeps the floor moving.',
    },
  ],
  purchasing: [
    {
      eyebrow: 'Purchasing & Suppliers',
      heading: 'Purchase orders that close the loop.',
      intro: "Issue POs, receive deliveries, and surface what your suppliers actually deliver on time. Operational intelligence that competitors don't surface at this price point.",
      diff: { lead: 'Unique to Manuva:', text: "PO variance, lead-time accuracy reports, and supplier scorecards — operational intelligence that Katana doesn't surface at any tier." },
      carried: 'Every delivery receipt, transfer, and adjustment updates your stock automatically. Bin-level locations mean nothing gets lost on the floor.',
    },
  ],
  production: [
    {
      eyebrow: 'BOMs & Manufacturing',
      heading: 'Build, version, and run BOMs that keep up with reality.',
      intro: 'Every component, every version, every change — captured. Cost and margin update automatically as your BOMs evolve.',
      diff: { lead: 'Unique to Manuva:', text: 'Yield %, BOM versioning with comparison, and templates — none of which Katana offers at any price.' },
      carried: 'Build a versioned bill of materials for every variant, then roll up costs automatically. Know your margin before the job starts, not after.',
    },
  ],
  sales: [
    {
      eyebrow: 'Orders & Fulfilment',
      heading: 'Every order, from sale to shipment.',
      intro: 'Shopify orders flow in automatically. Manual and B2B orders go in directly. Manuva tracks each line from component allocation through to delivery — so nothing slips.',
    },
    {
      eyebrow: 'Shopify & Platform',
      heading: 'Built around your Shopify store.',
      intro: 'Real-time webhook sync, not nightly batch imports. Orders drive production. Inventory stays accurate across every channel.',
    },
  ],
  planning: [
    {
      eyebrow: 'Production Planning · Pro',
      heading: 'Run the floor without a whiteboard.',
      intro: "Schedule jobs, track steps in sequence, and know exactly what's running and what's blocked — across every department, in real time.",
      carried: "Plan around your team's capacity, sell through Shopify with inventory synced automatically, and get the reports that matter — on-time rate, scrap, stock turn.",
    },
    {
      eyebrow: 'Capacity & Team · Pro',
      heading: 'Plan production around the people who actually do the work.',
      intro: 'Departments, staffing levels, hours available, and what each production run actually cost in labour. No competitor in this segment ships this module at this price.',
      diff: { lead: 'Manuva-only at this price:', text: 'Capacity planning with staff costing for $499/mo flat, unlimited users. MRPeasy charges per-user — a 10-person team hits $490/mo before any other features.' },
    },
  ],
  reporting: [
    {
      eyebrow: 'Costing & Profitability',
      heading: 'Know your margin before the job starts.',
      intro: 'Cost up your BOMs automatically. See margin per product. Watch profitability across the whole operation in real time.',
      diff: { lead: 'Unique to Manuva:', text: 'The financial profitability dashboard at Pro — Katana has no equivalent at any price.' },
    },
    {
      eyebrow: 'Reports & Analytics',
      heading: "Operational intelligence, not last week's spreadsheet.",
      intro: 'Live data on stock, supplier performance, PO accuracy, and dead stock — the reports that actually drive decisions.',
      diff: { lead: 'Unique to Manuva:', text: "PO variance, lead-time accuracy, and inventory integrity reports — operational intelligence buyers won't find in Katana, Qoblex, or Craftybase." },
    },
  ],
};

const FEATURES: Record<string, { title: string; tier?: string; desc: string }[]> = {
  inventory: [
    { title: 'Component & raw material tracking', desc: 'From bolts and fasteners to fabric and chemicals — track every input to your products.' },
    { title: 'Finished goods tracking', desc: 'Stock counts that update automatically as production completes and orders ship.' },
    { title: 'Inventory movements ledger', desc: 'A live log of every stock change — receipts, transfers, adjustments, consumption. Nothing disappears into thin air.' },
    { title: 'Stocktake & cycle counts', desc: 'Run full stocktakes or partial cycle counts. Variance is captured and reconciled with one click.' },
    { title: 'Activity log', desc: 'Who did what, when. Audit trail across every change in the system — for compliance and for sanity.' },
    { title: 'Low stock alerts', desc: 'Configurable thresholds per component. Get warned before you run out, not after.' },
    { title: 'Bin & aisle locations', tier: 'Growth+', desc: 'Tell your warehouse team exactly where each component lives. No more wandering around looking for stock.' },
    { title: 'Multi-warehouse', tier: 'Growth+', desc: 'Run stock across multiple locations — main warehouse, satellite stockroom, 3PL. Move inventory between them with full traceability.' },
    { title: 'Mobile barcode scanner', tier: 'Growth+', desc: 'A mobile-optimised scanner app for your warehouse team. Scan a barcode and the component resolves instantly — no round-trips to the server.' },
    { title: 'Scan-to-count', tier: 'Growth+', desc: 'Run stocktakes with a scanner. Open a session, scan components, enter counts. Progress tracked in real time — no paper tally sheets.' },
    { title: 'Scan-to-locate', tier: 'Growth+', desc: 'Scan a component barcode and assign it to its bin location on the spot. Batch updates confirmed in one step.' },
  ],
  purchasing: [
    { title: 'Purchase orders', desc: 'Create POs against suppliers, send them out, and track them through to receipt.' },
    { title: 'Supplier management', desc: 'Contacts, payment terms, lead times, and component pricing — all in one supplier record.' },
    { title: 'Goods inwards / receiving', desc: 'Receive deliveries against POs. Capture discrepancies (short delivery, wrong items, damaged stock) the moment they arrive.' },
    { title: 'Lead-time tracking', desc: 'Manuva measures promised vs actual lead times on every PO. Know which suppliers are reliable and which slip.' },
    { title: 'PO variance reporting', desc: 'What you ordered vs what you received vs what you were invoiced. Catches errors before they hit the books.' },
    { title: 'Spend by supplier', tier: 'Growth+', desc: 'See your total purchasing volume broken down by supplier, component, and time period.' },
    { title: 'Supplier scorecards', tier: 'Pro+', desc: 'A rolled-up rating for every supplier — on-time delivery %, fill rate, price stability, PO accuracy. Sort the suppliers worth doubling down on from the ones costing you money quietly.' },
  ],
  production: [
    { title: 'Component BOMs per variant', desc: 'Every Shopify variant gets its own bill of materials. Costs roll up automatically from component cost and quantity.' },
    { title: 'Yield % per BOM line', tier: 'Growth+', desc: 'Set realistic scrap allowances per component. Material requirements reflect what you actually consume.' },
    { title: 'BOM versioning', tier: 'Growth+', desc: 'Draft, publish, and roll back. Every change is captured — history never gets overwritten.' },
    { title: 'Side-by-side version comparison', tier: 'Growth+', desc: 'See added, removed, and changed components at a glance — with the cost and margin impact spelled out.' },
    { title: 'BOM templates', tier: 'Growth+', desc: 'Reuse common structures across product variants. Update the template once, propagate everywhere.' },
    { title: 'Production orders', desc: 'Issue work orders, allocate components, and track each run from start to finish.' },
    { title: 'Component allocation engine', desc: 'Allocates stock to orders automatically. Catches missing components before production starts.' },
  ],
  sales: [
    { title: 'Order list & pipeline view', desc: "All open orders in one place with live pipeline status — what's in stock, what's in production, and what's shipped. Filter by status, source, or date range." },
    { title: 'Manual & B2B orders', desc: "Don't sell through Shopify? Enter orders directly in Manuva. Components allocate, production kicks off, and delivery is tracked — the same as any Shopify order." },
    { title: 'Automatic component allocation', desc: 'When an order comes in, Manuva allocates the required components from stock against each BOM line. Shortfalls surface immediately — with the earliest open-PO ETA shown.' },
    { title: 'BOM linked per order line', desc: "Each sales line shows which BOM version it's running from, whether there's a BOM gap, and the planned vs actual margin for that line." },
    { title: 'Delivery tracking per line', desc: 'Mark individual order lines as shipped independently. Shopify orders auto-update on fulfilment. Partial shipments tracked from day one.' },
    { title: 'SLA & target ship dates', desc: 'Set lead times per order source (Shopify, B2B). Manuva calculates the target ship date and flags overdue orders before they become a complaint.' },
    { title: 'Shopify product & variant sync', desc: 'Products, variants, and inventory levels stay in sync between Manuva and Shopify automatically.' },
    { title: 'Webhook-driven real-time sync', desc: 'Order created in Shopify → Manuva allocates in seconds. No lag, no overnight rebuild.' },
    { title: 'Order sync & allocation', desc: 'Every Shopify order flows in, components allocate against stock, and production orders cascade — without anyone touching a spreadsheet.' },
    { title: 'Xero integration', tier: 'Growth+', desc: "Connect your Xero organisation. Manuva pushes bills from delivery receipts directly into Xero — no re-keying supplier invoices." },
    { title: 'SSO & advanced security', tier: 'Enterprise', desc: 'Single sign-on, SAML, advanced role permissions, and uptime SLA for teams that need them.' },
  ],
  planning: [
    { title: 'Floor board', tier: 'Pro+', desc: "A live kanban-style view of every job in the system — what's unstarted, running, queued, and blocked, grouped by department." },
    { title: 'Step-by-step job tracking', tier: 'Pro+', desc: 'Break each production run into routing steps. Start and complete steps individually. Actual start and end times recorded automatically.' },
    { title: 'Step dependencies', tier: 'Pro+', desc: 'Block steps until their predecessors finish. Completing step N automatically unlocks everything waiting on it — no manual chasing.' },
    { title: 'Shop floor operator view', tier: 'Pro+', desc: 'A simplified, tablet-friendly view of active and queued steps by department. Operators see only what they need — no admin noise.' },
    { title: 'Production milestone notifications', tier: 'Pro+', desc: 'Trigger customer emails automatically when a production step completes — e.g. "your order is out of QC". Configured per BOM, sent once per order.' },
    { title: 'Job scheduling', tier: 'Pro+', desc: 'Schedule production runs against your staffing calendar. Manuva calculates earliest start windows and flags capacity clashes before they happen.' },
    { title: 'Departments', tier: 'Pro+', desc: 'Model your shop floor by department — assembly, finishing, packing, QC. Each with their own staffing and capacity.' },
    { title: 'Staffing levels', tier: 'Pro+', desc: 'Set how many people work in each department, their hours, and their cost rates. Manuva builds your capacity from there.' },
    { title: 'Capacity planning', tier: 'Pro+', desc: 'See your production load against available staff hours — week by week, department by department. Spot bottlenecks before they happen.' },
    { title: 'Actual vs planned time', tier: 'Pro+', desc: 'Track time per production order. Compare against estimates. Improve your future planning with real data.' },
    { title: 'Staff costing', tier: 'Pro+', desc: 'Roll labour costs into production economics. Know what each finished unit actually cost — components and people.' },
    { title: 'Utilisation reporting', tier: 'Pro+', desc: "See how much of your team's available time was actually consumed by production. Identify slack and overload." },
  ],
  reporting: [
    { title: 'Cost per unit', tier: 'Growth+', desc: 'BOM rollup automatically calculates your finished-goods cost from component prices. Updates as supplier prices change.' },
    { title: 'Margin tracking per product', tier: 'Growth+', desc: 'Sell price minus cost — for every product, every variant. See which SKUs are actually pulling their weight.' },
    { title: 'Inventory valuation', tier: 'Growth+', desc: 'Live value of stock on hand — by component, by location, in total. The number you give your accountant at month-end.' },
    { title: 'COGS tracking', tier: 'Growth+', desc: 'Cost of goods sold flows through automatically as orders ship. No spreadsheet reconciliation at month-end.' },
    { title: 'Financial profitability dashboard', tier: 'Pro+', desc: 'Revenue, COGS, gross margin, and operating costs in one live view. The CFO summary you can pull up in 10 seconds.' },
    { title: 'Multi-cost allocation', tier: 'Pro+', desc: 'Allocate labour, components, and overhead to each production run. True unit economics, not estimates.' },
    { title: 'Real-time dashboard', desc: 'Open orders, components running low, fulfillment rate, and inventory value — all on one screen.' },
    { title: 'Stock on hand', tier: 'Growth+', desc: 'Current balances across every component and finished good, filterable by location and category.' },
    { title: 'Inventory movements', tier: 'Growth+', desc: 'Every stock change over a time range — receipts, consumption, transfers, adjustments.' },
    { title: 'Spend by supplier', tier: 'Growth+', desc: 'Total purchasing volume broken down by supplier, component, and period.' },
    { title: 'PO variance', desc: 'Ordered vs received vs invoiced. Surface the gaps your accounts team will catch eventually.' },
    { title: 'Lead-time accuracy', desc: 'Promised vs actual lead times per supplier. Renegotiate from data, not gut feel.' },
    { title: 'Dead stock & slow-movers', desc: "Identify components and finished goods that haven't moved. Free up capital and floor space." },
    { title: 'Inventory integrity audit', desc: 'Surfaces phantom stock, negative balances, and reconciliation issues — before they corrupt your numbers.' },
    { title: 'Stocktake history', desc: 'Every count, every variance, every reconciliation — preserved for audit.' },
    { title: 'Date range filtering', tier: 'Growth+', desc: 'Every report scoped to any period — month, quarter, fiscal year, custom range.' },
    { title: 'PDF & CSV export', tier: 'Pro+', desc: 'Every report exportable for board packs, accountants, and ad-hoc analysis.' },
    { title: 'Custom filters & segments', desc: 'Slice every report by category, location, supplier, or any combination.' },
  ],
};

const pad = (n: number) => String(n).padStart(2, '0');
const total = Object.values(FEATURES).reduce((a, f) => a + f.length, 0);

const description =
  'Inventory, BOMs, production, purchasing, capacity, costing, and reporting — everything Manuva does, in one place.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://manuva.app/' },
      { '@type': 'ListItem', position: 2, name: 'Features', item: 'https://manuva.app/features' },
    ],
  },
];
---
<Base
  title="Features — Manuva"
  description={description}
  twitterDescription={description}
  canonical="https://manuva.app/features"
  current="/features"
  headInk="light"
  {schema}
>
  <section class="hero tall mv-field-ink">
    <span class="ghostnum num" aria-hidden="true" data-n={pad(DOMAINS.length)}></span>
    <span class="eyebrow" style="opacity:.75">{pad(DOMAINS.length)} domains &middot; {total} features</span>
    <h1 class="disp">Everything you need to run <span class="hl">manufacturing operations</span></h1>
    <p class="sub" style="opacity:.88;max-width:50ch">
      Connected inventory, BOMs, production, purchasing, capacity, costing, and reporting — built specifically
      for product brands that make what they sell.
    </p>
    <span style="font-size:14px;opacity:.8">30-day free trial. No credit card. Unlimited users from Growth.</span>
    <ul class="index">
      {DOMAINS.map((d, i) => (
        <li>
          <a href={`#${d.id}`} data-jump={String(i)}><b>{pad(i + 1)}</b>{d.name}</a>
        </li>
      ))}
    </ul>
  </section>

  {DOMAINS.map((d, i) => (
    <section class={`dom mv-field-${d.field}`} id={d.id} data-chip={d.name} data-field={d.field} aria-labelledby={`h-${d.id}`}>
      {/* The cut. `data-from` is the field you are arriving from, which the
          engine paints as the backdrop the new field clips in over — so the
          sequence has to match the DOMAINS order. */}
      <div class="intro" data-from={i ? DOMAINS[i - 1].field : 'ink'} data-shape={String(i)}>
        <div class="ipin">
          <div class={`cut mv-field-${d.field}`}>
            <span class="pnum num" data-rate="30" aria-hidden="true" data-n={pad(i + 1)}></span>
            <span class="eyebrow" data-rate="70" style="opacity:.8">
              {pad(i + 1)} / {pad(DOMAINS.length)} &middot; {FEATURES[d.id].length} features
            </span>
            <h2 class="disp" id={`h-${d.id}`} data-rate="50">{d.name}</h2>
            <p class="pline" data-rate="90">{d.line}</p>
          </div>
        </div>
      </div>
      {/* Two columns from 1100 up, the same .split the rest of the site uses
          for a heading against its body. As one narrow block it read as a
          column crushed against the left while the feature list below it ran
          the full width. The comment sits above the map: inside the returned
          expression it is a block, not a comment, and the build fails. */}
      {AREAS[d.id].map((a) => (
        <div class="arealead split">
          <div class="leadhead">
            {/* Full strength. At .7 this measured 4.44:1 on aqua — a 12px
                uppercase label has no headroom to mute into, which is the
                same call this project already made for cobalt, violet and
                flare. */}
            <span class="eyebrow">{a.eyebrow}</span>
            <h3 class="disp">{a.heading}</h3>
          </div>
          <div class="leadbody">
            <p class="sub">{a.intro}</p>
            {a.carried && <p class="sub">{a.carried}</p>}
            {a.diff && <p class="diff"><strong>{a.diff.lead}</strong> {a.diff.text}</p>}
          </div>
        </div>
      ))}
      <ul class="nlist two three">
        {FEATURES[d.id].map((f, j) => (
          <li>
            <span class="i">{pad(i + 1)}.{j + 1}</span>
            <h3>
              {f.title}
              {f.tier && <> <a href="/pricing" class="tier" aria-label={`${f.title}: included from ${f.tier} — see pricing`}>{f.tier}</a></>}
            </h3>
            <p>{f.desc}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {/* The old page's own "Where to next" block. Dropped in the rebuild; it is
      the only cross-link out of a very long page. */}
  <section class="sec" style="padding-block:40px">
    <span class="eyebrow" style="opacity:.6">Where to next</span>
    <nav class="related" aria-label="Related pages">
      <a href="/pricing">Pricing &amp; plans</a>
      <a href="/alternatives/katana">Manuva vs Katana</a>
      <a href="/alternatives/mrpeasy">Manuva vs MRPeasy</a>
      <a href="/about">About Manuva</a>
    </nav>
  </section>

  <section class="outro mv-field-lime" data-chips-end>
    <p class="disp">Ready to see it in action?</p>
    <p class="sub">Full Pro access for 30 days. No credit card required. Set up in a day, not a quarter.</p>
    <div class="row">
      <a class="pill ink" href="/pricing">See pricing</a>
      <a class="pill ghost" href={APP_URL}>Start free</a>
    </div>
  </section>


  <nav id="chips" aria-label="Jump to domain"></nav>
</Base>
