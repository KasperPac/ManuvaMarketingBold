---
import Base from '../layouts/Base.astro';
import { APP_URL, CONTACT_EMAIL } from '../site';

// Rebuilt on the new design (MVBOLD-24). The last page on the pre-rebuild
// components; nothing on the site runs on the old design after this.
//
// Motion: one moment — a single shape cut into the principles. It takes the
// shutter (shape 5), which no other page uses, so every page in the site now
// animates differently from its neighbours.
//
// Every word is carried across, including the sectors row that moved here
// from the home page in MVBOLD-21 and the contact block that moved here from
// the home page before that. Six links across the site plus the Organization
// schema's contactPoint.url target #contact, so that anchor stays.

const description =
  'Manuva is manufacturing operations software for Shopify-first product brands, operated by Pac Technologies Pty Ltd in Sydney, Australia.';

// The old page's own six principle cards, verbatim titles and body copy.
const PRINCIPLES = [
  {
    title: 'Flat pricing, no per-seat tax',
    desc: 'Software bills should not scale with the size of your shop floor. Manuva charges per account, not per user — so adding a packer, a QC lead, or a third-shift supervisor never raises your invoice.',
  },
  {
    title: 'Live, not batch',
    desc: 'Shopify orders cascade to production within seconds via webhooks — not nightly batch imports. Stock counts update as production completes and orders ship. The number on screen is the number on the floor.',
  },
  {
    title: 'Built around real workflows',
    desc: 'Bin locations, yield %, BOM versioning with rollback, PO variance, supplier lead-time accuracy — the operational details that hide in spreadsheets at most shops. Manuva surfaces them as first-class features.',
  },
  {
    title: 'Days, not quarters',
    desc: 'Setup happens in days. Migration tools, CSV imports, and Shopify connection take care of the mechanical work. You should be running production through Manuva within the first week, not waiting for an implementation consultant.',
  },
  {
    title: 'Your data is yours',
    desc: "Full export on every plan. No vendor lock-in. We don't use customer data to train, fine-tune, or evaluate any machine-learning or artificial-intelligence model.",
  },
  {
    title: 'Quarterly competitor checks',
    desc: 'When we make a comparison claim about Katana, MRPeasy, or any other tool, we date-stamp it and re-verify every quarter. If we get something wrong, write to us — corrections ship in the next release.',
  },
] as const;

// The old page's own company-info rows, verbatim label/value pairs.
const COMPANY = [
  { label: 'Operating entity', value: 'Pac Technologies Pty Ltd' },
  { label: 'Headquarters', value: 'Sydney, Australia' },
  { label: 'Launched', value: '2026' },
  { label: 'Sectors served', value: 'Manufacturing & product brands selling on Shopify, WooCommerce, Amazon, Etsy' },
] as const;

// Carried from the home page in MVBOLD-21, where this row and its line were a
// whole section earning very little. The eyebrow it used there was "Who runs
// Manuva" — this page's own heading — so it was always describing what
// belongs here.
const SECTORS = [
  'Furniture', 'Food', 'Cosmetics', 'Supplements',
  'Apparel', 'Hardware', 'Electronics', 'Manufacturing',
] as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://manuva.app/' },
      { '@type': 'ListItem', position: 2, name: 'About', item: 'https://manuva.app/about' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    url: 'https://manuva.app/about',
    name: 'About Manuva',
    mainEntity: { '@id': 'https://manuva.app/#org' },
    description:
      'About Manuva — manufacturing operations software for Shopify-first product brands, operated by Pac Technologies Pty Ltd in Sydney, Australia.',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="About Manuva — Manufacturing Operations Software"
  {description}
  ogDescription={description}
  twitterDescription={description}
  canonical="https://manuva.app/about"
  ogType="article"
  current="/about"
  headInk="light"
  {schema}
>
  {/* mint: the principles below are ink, the contact card violet and the
      close flare, so the hero repeats nothing. */}
  <section class="hero mv-field-mint">
    <span class="ghostnum num" aria-hidden="true" data-n="06"></span>
    <span class="eyebrow" style="opacity:.75">About Manuva</span>
    <h1 class="disp" style="max-width:15ch">
      Manufacturing operations software, built for <span class="hl">product brands that ship.</span>
    </h1>
    <p class="sub" style="opacity:.9;max-width:52ch">
      Manuva is a connected platform for inventory, bills of materials, production, purchasing, capacity,
      costing, and reporting — built specifically for small and mid-size manufacturers that sell through
      Shopify and adjacent channels.
    </p>
  </section>

  <section class="sec">
    <div class="split">
      <div class="stick" style="display:grid;gap:18px">
        <span class="eyebrow" style="opacity:.6">What we build</span>
        <h2 class="disp" style="font-size:clamp(36px,7vw,64px)">One system covering the whole shop floor.</h2>
      </div>
      <div style="display:grid;gap:20px">
        <p class="sub" style="color:var(--ink-muted);max-width:62ch">
          Manuva replaces the spreadsheets, fragmented apps, and legacy MRP systems that most product brands run
          their operations on. Inventory counts, bills of materials, work orders, purchase orders, capacity plans,
          cost rollups, and Shopify sync — all in one place, all live, all priced flat.
        </p>
        <p class="sub" style="color:var(--ink-muted);max-width:62ch">
          The product is built for shops that <strong>make what they sell</strong>: furniture, food, cosmetics,
          supplements, apparel, hardware, electronics. Tools designed for large industrial manufacturers tend to be
          priced and structured for an audience Manuva isn't. Tools designed for retailers don't cover production.
          Manuva fills the gap.
        </p>
      </div>
    </div>
  </section>

  {/* The page's one pinned moment. ink, because six principles is long-form
      body copy and a rotation hue behind that much reading would be the
      loudest thing on the page. */}
  <section class="mv-field-ink">
    <div class="intro" data-from="paper" data-shape="5">
      <div class="ipin">
        <div class="cut mv-field-ink">
          <span class="pnum num" data-rate="30" aria-hidden="true" data-n={pad(PRINCIPLES.length)}></span>
          <span class="eyebrow" data-rate="70" style="color:var(--field-lime)">How we build</span>
          <h2 class="disp" data-rate="50">The principles behind the product.</h2>
          <p class="pline" data-rate="90">Six of them, and we are held to all six.</p>
        </div>
      </div>
    </div>
    <div class="wrap" style="padding-bottom:96px">
      <ul class="nlist two">
        {PRINCIPLES.map((p, i) => (
          <li>
            <span class="i">{pad(i + 1)}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="split">
      <div class="stick" style="display:grid;gap:18px">
        <span class="eyebrow" style="opacity:.6">Who runs Manuva</span>
        <h2 class="disp" style="font-size:clamp(36px,7vw,64px)">Who runs Manuva.</h2>
        <p class="sub" style="color:var(--ink-muted)">
          Manuva is operated by Pac Technologies Pty Ltd, an Australian private company based in Sydney. The
          platform launched publicly in 2026.
        </p>
        <p class="sub" style="color:var(--ink-muted)">Built for shops that make what they sell.</p>
        <ul class="logorow sectors">
          {SECTORS.map((name) => <li>{name}</li>)}
        </ul>
      </div>
      <div class="ptable company">
        {COMPANY.map((row) => (
          <div class="prow"><span>{row.label}</span><span>{row.value}</span></div>
        ))}
        <div class="prow"><span>Contact</span><span><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span></div>
        <div class="prow"><span>Application</span><span><a href={APP_URL}>app.manuva.app</a></span></div>
        <div class="prow"><span>Privacy</span><span><a href="/privacy">Privacy policy</a></span></div>
        <div class="prow"><span>Terms</span><span><a href="/terms">Terms of service</a></span></div>
      </div>
    </div>
  </section>

  {/* Six links across the site and the Organization schema's contactPoint.url
      target this anchor, so #contact stays on this element. */}
  <section class="sec" id="contact">
    {/* A violet card on paper, not a full-bleed violet fold: the closing
        field follows directly and two fields may not touch. The old page
        carried this as a panel for the same reason. */}
    <article class="pcard mv-field-violet contact-card">
      <span class="eyebrow" style="opacity:.8">Get in touch</span>
      <h2 class="disp" style="font-size:clamp(32px,5.4vw,52px);margin:0">Get in touch</h2>
      <p class="sub" style="opacity:.9;max-width:54ch">
        Whether you're ready to start a trial or just want to see how Manuva fits your shop, we'd love to talk.
      </p>
      <div class="ptable">
        <div class="prow"><span>Email</span><span><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></span></div>
        <div class="prow"><span>Response</span><span>We reply within one business day</span></div>
      </div>
      <a class="pill white" href={`mailto:${CONTACT_EMAIL}`} style="justify-self:start">Email us</a>
    </article>
  </section>

  {/* flare, and both of the old band's own actions with their own labels.
      "Book a demo" targets /about#contact — a self-link on this page, which
      is what the old band did: the anchor is this page's and the label is
      the one six other CTAs across the site use. */}
  <section class="outro mv-field-flare">
    <p class="disp">See Manuva in action.</p>
    <p class="sub">30-day free trial, full Pro access. No credit card required. Set up in a day.</p>
    <div class="row">
      <a class="pill white" href={APP_URL}>Start free trial &rarr;</a>
      <a class="pill ghost" href="/about#contact">Book a demo</a>
    </div>
  </section>
</Base>
