---
import '../styles/site.css';
import SiteHead from '../components/site/SiteHead.astro';
import Drawer from '../components/site/Drawer.astro';
import SiteFoot from '../components/site/SiteFoot.astro';
import Motion from '../components/site/Motion.astro';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  /** Old page's og:description/twitter:description are sometimes a shorter,
   * trimmed variant of the main meta description (e.g. both /alternatives/
   * pages drop the trailing "14-day free trial…" clause). Optional, additive:
   * every other page omits it and keeps the previous single-`description`
   * behaviour untouched. */
  ogDescription?: string;
  /** Old page's og:type — "article" for the two /alternatives/ pages,
   * "website" (the prior hardcoded default) everywhere else so far. */
  ogType?: string;
  /** Genuinely optional, no fallback to `description` or `ogDescription`:
   * a first pass wired twitter:title/twitter:description unconditionally
   * off `ogDescription`'s default, which silently emitted the long meta
   * description as the Twitter card body on / and /pricing — both old
   * pages carry a shorter Twitter variant Base had never read. Every page
   * that wants a Twitter card must supply the real value from its own old
   * page's <head>; pages that don't pass this get no twitter:title/
   * description at all, same as before Task 10 touched this file. */
  twitterDescription?: string;
  /** JSON-LD nodes. */
  schema?: Record<string, unknown>[];
  /** Which NAV_LINKS href is the current page, for aria-current. */
  current?: string;
  /** The field the page opens on. The fixed header takes the ink of whatever
   * is under it at runtime, but it has to start correct for the first paint
   * — otherwise every page flashes white-on-white or black-on-black before
   * the first scroll frame runs. */
  headInk?: 'light' | 'dark';
}
const {
  title, description, canonical, ogImage = '/og-image.png',
  ogDescription = description, ogType = 'website', twitterDescription, schema,
  current, headInk = 'light',
} = Astro.props;

// The ten token files are concatenated into /_ds/tokens.css by
// scripts/sync-ds.js, which owns the order (it is this list, unchanged). Ten
// separate <link>s meant ten render-blocking requests per page for ten files
// that only ever change together, as one vendored export. The individual
// files are still synced and still served — this only stops the layout asking
// for them one at a time.

// Astro.site is undefined when this layout is rendered through the container
// API (astro/container) without an astroConfig, e.g. in unit tests. Fall back
// to the raw path there; dev/build always have `site` set in astro.config.mjs.
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site) : ogImage;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover: the chip bar sits on env(safe-area-inset-bottom)
        and the hero is sized in svh, both of which need the viewport to run
        under the notch rather than stop at it. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {/* All four fixed, identical across all eight source pages (verified by
        reading each page's own raw <head>, not assumed from one) — the
        og-image asset itself never varies per page, so neither does its own
        width/height/alt. Dropped entirely until Task 14 (team-lead review):
        Base.astro's og:* block was written in Task 1 and never revisited
        once later tasks added real per-page og:title/description. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Manuva — Manufacturing operations, finally simple" />
    <meta property="og:site_name" content="Manuva" />
    {/* Whole block conditional together, not just title/description under an
        unconditional twitter:card — a lone twitter:card with no title/body
        is a half-populated card. Tasks 11-12 (/about, /privacy, /terms) are
        the pages most likely to omit twitterDescription next; this way
        omitting it drops the whole card, not a broken remainder of one. */}
    {twitterDescription && (
      <>
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={twitterDescription} />
        <meta name="twitter:image" content={ogImageUrl} />
      </>
    )}

    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* The design system's font stylesheet, requested here as well as by the
        @import inside tokens.css. Behind the @import the browser could not ask
        for it until tokens.css had arrived, which put a second render-blocking
        round trip in front of first paint (MVBOLD-31). Same URL, so the @import
        is then served from the same response. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700&family=Roboto:wght@400;500&family=Flow+Circular&display=swap" />
    <link rel="stylesheet" href="/_ds/tokens.css" />

    {/* Whether motion runs is decided here, once, before first paint, and
        written to <html data-motion>. Both the CSS and Motion.astro read that
        attribute rather than the media query directly, so there is one answer
        instead of two that can disagree — and so a visitor can override it.
        The OS preference is only the default. Inline and synchronous: a
        deferred script would let the pinned layout paint and then collapse. */}
    <script is:inline>
      (() => {
        let m = null;
        try { m = localStorage.getItem('mv-motion'); } catch {}
        if (m !== 'on' && m !== 'off') {
          m = matchMedia('(prefers-reduced-motion:reduce)').matches ? 'off' : 'on';
        }
        document.documentElement.dataset.motion = m;
        // The home hero plays once per visit (MVBOLD-37). Once a visitor has
        // scrolled it to its end this session, the page opens on the finished
        // room as a one-screen still: decided here, before first paint, so the
        // pinned layout never paints and collapses. That hero is shorter than
        // the one a restored scroll position was measured on, so the browser
        // does not restore it; Motion.astro does, against the content below.
        let d = null;
        try { d = sessionStorage.getItem('mv-hero-done'); } catch {}
        if (m === 'on' && d === '1') {
          document.documentElement.dataset.hero = 'done';
          if (location.pathname === '/') history.scrollRestoration = 'manual';
        }
      })();
    </script>
    {/* With JS off the attribute is never set, and the shape cuts would pin
        for screens of scroll with nothing moving. The flat layout is the
        correct no-JS rendering. (The home stage was flattened here too until
        it became a static grid, MVBOLD-34.) */}
    <noscript><style>
      .intro{height:auto}.ipin{position:relative;height:auto;min-height:100svh}
      .cut{position:relative;min-height:100svh}
    </style></noscript>

    {schema && schema.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body data-head-ink={headInk}>
    <a class="skip" href="#main">Skip to content</a>
    <Drawer {current} />
    <SiteHead {current} />
    <main id="main"><slot /></main>
    <SiteFoot />
    <Motion />
  </body>
</html>
