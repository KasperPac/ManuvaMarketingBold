---
import Logo from '../ds/Logo.astro';
import { FOOTER_GROUPS, CONTACT_EMAIL } from '../../site';
const year = new Date().getFullYear();

// A heading of more than one word produced id="foot-feature overview". An id
// cannot contain a space, so the aria-labelledby resolved to nothing and the
// nav lost its accessible name.
const slug = (h: string) => `foot-${h.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

// Ink footer ending on the full-width lockup, per the design. The column
// groups come from site.ts so the footer and the nav cannot drift apart.
//
// <nav> per group with its heading as the accessible name: the groups were
// bare divs headed by spans before, which gave the footer no landmark and no
// heading structure. Kept from the previous build.
---
<footer class="site-foot">
  <div class="cols">
    {FOOTER_GROUPS.map((g) => (
      <nav aria-labelledby={slug(g.heading)}>
        <h2 class="eyebrow" id={slug(g.heading)}>{g.heading}</h2>
        {g.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    ))}
    <nav aria-labelledby="foot-talk">
      <h2 class="eyebrow" id="foot-talk">Talk to us</h2>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </nav>
  </div>
  <span class="logo-big" role="img" aria-label="Manuva"><Logo variant="lockup" fill decorative /></span>
  {/* Outside .legal on purpose: that row sets opacity:.6, and a parent's
      opacity is a group a child cannot opt out of — the label composited to
      4.27:1 there and nothing on the button could lift it. aria-pressed and
      the text are set by the script from the real state rather than rendered
      here, because this is a static build and any baked-in state would be
      wrong for half the visitors. */}
  <button class="motion-toggle" type="button" aria-pressed="false">
    <i aria-hidden="true"></i><span class="motion-label">Motion</span>
  </button>
  <div class="legal">
    <span>&copy; {year} Pac Technologies Pty Ltd</span>
    <span>Manufacturing operations, finally simple.</span>
  </div>
</footer>

<script>
  // The engine initialises once from <html data-motion>, so changing the mode
  // reloads rather than trying to tear down and rebuild six pinned panels,
  // the marquee loop and the chip bar in place. A preference toggle is a
  // reasonable place to spend a reload; a half-reinitialised stage is not.
  const btn = document.querySelector<HTMLButtonElement>('.motion-toggle');
  if (btn) {
    const label = btn.querySelector('.motion-label')!;
    const sync = () => {
      const on = document.documentElement.dataset.motion === 'on';
      btn.setAttribute('aria-pressed', String(on));
      label.textContent = on ? 'Motion on' : 'Motion off';
      btn.title = on
        ? 'Turn off the scroll animations'
        : 'Turn on the scroll animations';
    };
    sync();
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.motion === 'on' ? 'off' : 'on';
      try { localStorage.setItem('mv-motion', next); } catch {}
      document.documentElement.dataset.motion = next;
      sync();
      location.reload();
    });
  }
</script>