---
export interface Props {
  /** Self-hosted still, always used. Never a third-party thumbnail URL. */
  poster: string;
  alt: string;
  /** Self-hosted mode. Mutually exclusive with youtubeId. */
  src?: string;
  /** Facade mode. Mutually exclusive with src. */
  youtubeId?: string;
  /** Names the video for the play button's accessible name ("Play video:
   * {title}") whenever there's a control to press — self and facade modes
   * only; still mode has no button. Independent of `caption` below: a
   * video with a control always needs an accessible name, but doesn't
   * always want that same name repeated visibly under the poster (Task 5:
   * product.astro's domain cards already carry the name as their own
   * heading immediately above the video — a visible caption there just
   * duplicated it. The home page's explainer has no such heading and
   * wants the caption). */
  title?: string;
  /** Whether `title` also renders as a visible <figcaption>. Defaults to
   * true so every caller that predates this prop (the home page's
   * explainer) keeps its exact existing output unchanged. */
  caption?: boolean;
  class?: string;
}
const { poster, alt, src, youtubeId, title, caption = true, class: className } = Astro.props;

if (src && youtubeId) {
  throw new Error(
    'Video: both `src` and `youtubeId` were supplied. Pick one — self-hosted or facade.',
  );
}

const label = title ? `Play video: ${title}` : 'Play video';
const mode = src ? 'self' : youtubeId ? 'facade' : 'still';
---
<figure class:list={['site-video', className]} data-mode={mode}>
  {/* .site-video-frame, not the outer <figure>, is the positioning context for
      poster/play — see .site-video-frame in site.css. The poster is
      position:absolute; inset:0; height:100%, sized to its containing block's
      own content height. When the containing block was the figure itself, a
      <figcaption> sibling stretched that content height past the video's own,
      and the poster (being out-of-flow) covered the extra space the caption
      sat in — painting over it regardless of DOM order, since CSS's painting
      order puts positioned elements after non-positioned in-flow siblings no
      matter where either sits in the source (Task 3 fix round; caught by
      measuring real elementFromPoint() hits, not by reading the opacity the
      cascade resolved). Scoping the frame to just the visual elements makes
      that geometrically impossible instead of relying on stacking order. */}
  <div class="site-video-frame">
    {mode === 'self' && (
      <>
        <video class="site-video-el" preload="none" poster={poster} controls playsinline>
          <source src={src} type="video/mp4" />
        </video>
        <img class="site-video-poster" src={poster} alt={alt} loading="lazy" decoding="async" />
        <button type="button" class="site-video-play" aria-label={label}>
          <span aria-hidden="true">▶</span>
        </button>
      </>
    )}

    {mode === 'facade' && (
      <>
        <img class="site-video-poster" src={poster} alt={alt} loading="lazy" decoding="async" />
        <button type="button" class="site-video-play" aria-label={label}
                data-youtube-id={youtubeId} data-youtube-title={title ?? ''}>
          <span aria-hidden="true">▶</span>
        </button>
      </>
    )}

    {mode === 'still' && (
      <img class="site-video-poster" src={poster} alt={alt} loading="lazy" decoding="async" />
    )}
  </div>

  {title && caption && <figcaption class="site-video-caption">{title}</figcaption>}
</figure>

<script>
  document.querySelectorAll('.site-video').forEach((fig) => {
    const btn = fig.querySelector<HTMLButtonElement>('.site-video-play');
    if (!btn) return;
    // .site-video-frame, not the figure, holds the visual (video/poster/
    // button) elements — see the markup comment above. Replacements go into
    // it, not the figure, so a caption sibling never ends up back inside the
    // positioned frame.
    const frame = fig.querySelector('.site-video-frame') ?? fig;

    const ytId = btn.dataset.youtubeId;

    btn.addEventListener('click', () => {
      if (ytId) {
        // First contact with YouTube happens here, on an explicit click — never on load.
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0`;
        iframe.title = btn.dataset.youtubeTitle || 'Video';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
        iframe.setAttribute('allowfullscreen', '');
        iframe.className = 'site-video-el';
        frame.querySelector('.site-video-poster')?.remove();
        btn.remove();
        frame.prepend(iframe);
        iframe.focus();
        return;
      }

      const video = fig.querySelector<HTMLVideoElement>('video');
      if (!video) return;
      fig.querySelector('.site-video-poster')?.remove();
      btn.remove();
      video.play();
      video.focus();
    });
  });
</script>
