---
import Logo from '../ds/Logo.astro';
import { NAV_LINKS, APP_URL } from '../../site';

export interface Props {
  current?: string;
}
const { current } = Astro.props;

// The full-screen ink drawer: slides down 400ms, Escape closes, body scroll
// locked while open. The design specifies all three.
//
// The focus trap, the scroll-lock gap compensation and the focus restore are
// carried over from the previous build rather than rewritten — they were
// covered by four e2e tests that all still apply, and the handoff explicitly
// says to port the old site's trap rather than rebuild it.
---
<div id="drawer" aria-hidden="true">
  <span class="mark dmark" aria-hidden="true"><Logo variant="lockup" fill decorative /></span>
  <button class="x" type="button" aria-label="Close menu">&times;</button>
  {NAV_LINKS.map((l) => (
    <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>
  ))}
  <a class="small" href={APP_URL}>Sign in</a>
  <a class="small" href={APP_URL} style="margin-top:0">Start free &rarr;</a>
</div>

<script>
  const drawer = document.getElementById('drawer')!;
  const burger = document.querySelector<HTMLButtonElement>('.burger')!;
  const closeBtn = drawer.querySelector<HTMLButtonElement>('.x')!;
  const FOCUSABLE = 'a[href], button:not([disabled])';
  let lastFocused: HTMLElement | null = null;

  const setOpen = (open: boolean) => {
    // Measure before locking scroll: once overflow is hidden the scrollbar
    // disappears and clientWidth grows, so the gap has to be captured first.
    const gap = open ? window.innerWidth - document.documentElement.clientWidth : 0;
    drawer.dataset.open = open ? '1' : '';
    drawer.setAttribute('aria-hidden', String(!open));
    burger.setAttribute('aria-expanded', String(open));
    // The label is the button's whole accessible name — the control is three
    // bars with no text — so it has to track the state too.
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
    document.body.style.paddingRight = open ? `${gap}px` : '';
    if (open) {
      lastFocused = document.activeElement as HTMLElement;
      drawer.querySelector<HTMLElement>(FOCUSABLE)?.focus();
    } else {
      lastFocused?.focus();
    }
  };

  burger.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (drawer.dataset.open !== '1') return;
    if (e.key === 'Escape') { setOpen(false); return; }
    if (e.key !== 'Tab') return;
    const items = [...drawer.querySelectorAll<HTMLElement>(FOCUSABLE)];
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
</script>
