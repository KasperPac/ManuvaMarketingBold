---
// The motion engine, ported from _ds/ui_kits/marketing/site.js.
//
// Two things change from the reference and nothing else:
//   1. It no longer injects the header, drawer or footer. Those are real
//      server-rendered components now (handoff prototype shortcut #1), so this
//      is only the scroll behaviour.
//   2. It no longer fetches and inlines the logo SVG. Logo.astro masks
//      currentColor, which paints identically with no request.
//
//   3. The rendered progress is damped rather than snapped to scroll
//      position. The design reads the scroll offset and writes the shape
//      straight from it, which is exact but steppy: measured on the deployed
//      home page, one ~100px wheel notch moved the iris 39.9% of its travel
//      at the steepest part of the cubic. A wheel delivers discrete jumps, so
//      a directly-driven shape can only jump with it. Damping keeps the same
//      choreography and the same curve and lets each notch arrive as a sweep.
//
// Everything else is the design: shapes never fades, driven off scroll
// position rather than an IntersectionObserver so a fast flick or a restored
// scroll cannot strand a transition, and clip-path/transform only.
---
<script>
  import { canSwap, coarseCount, frameAt, loadOrder, nearestLoaded } from '../../lib/scrub';

  // Base.astro decided this before first paint and wrote it to
  // <html data-motion>, seeded from prefers-reduced-motion unless the visitor
  // overrode it. Reading the attribute rather than the media query keeps the
  // script and the stylesheet on the same answer.
  const reduce = document.documentElement.dataset.motion !== 'on';
  const ease = (u: number) => (u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);
  const cl = (v: number) => Math.min(1, Math.max(0, v));

  // Exponential follow, frame-rate independent: TAU is the time to close ~63%
  // of the remaining distance, so a 120Hz display and a 60Hz one settle over
  // the same wall clock instead of the faster one arriving sooner. 90ms is
  // short enough that the shape still reads as scroll-driven rather than
  // lagging behind the page.
  const TAU = 90;
  const damp = (cur: number, target: number, dt: number) =>
    cur + (target - cur) * (1 - Math.exp(-dt / TAU));
  // Below this the follow has visually arrived; holding the loop open for
  // another 0.05% of travel only costs frames.
  const SETTLED = 0.0005;

  // Big shapes, never fades. Indexed with data-shape.
  const SHAPES: ((u: number) => string)[] = [
    (u) => `circle(${u * 152}% at 50% 62%)`,
    (u) => `polygon(0% ${118 - u * 168}%,100% ${152 - u * 168}%,100% 102%,0% 102%)`,
    (u) => { const r = u * 118; return `polygon(50% ${50 - r}%,${50 + r}% 50%,50% ${50 + r}%,${50 - r}% 50%)`; },
    (u) => `inset(0% ${102 - u * 104}% 0% 0%)`,
    (u) => `polygon(${100 - u * 142}% 0%,102% 0%,102% 102%,${142 - u * 142}% 102%)`,
    (u) => `inset(${(1 - u) * 50}% 0% ${(1 - u) * 50}% 0%)`,
  ];

  const drift = (root: Element, amt: number) =>
    root.querySelectorAll<HTMLElement>('[data-rate]').forEach((e) => {
      e.style.transform = `translate3d(0,${amt * Number(e.dataset.rate)}px,0)`;
    });

  // The header takes the ink of whatever field is under it.
  const head = document.querySelector<HTMLElement>('.site-head');
  function headColor() {
    if (!head) return;
    head.style.visibility = 'hidden';
    const el = document.elementFromPoint(innerWidth / 2, 32);
    head.style.visibility = '';
    let n: Element | null = el;
    while (n && n !== document.body) {
      const bgc = getComputedStyle(n).backgroundColor;
      if (bgc && bgc !== 'rgba(0, 0, 0, 0)' && bgc !== 'transparent') break;
      n = n.parentElement;
    }
    const under = getComputedStyle(n || document.body);
    head.style.color = under.color;
    // The design leaves the bar transparent and only recolours its ink, which
    // works over a full-bleed field and not at all over a paper section: the
    // links sat directly on the copy and competed with it. Docked, the bar
    // takes the background of whatever it is over as well as the ink, so it
    // reads as a bar rather than as floating text.
    head.style.background = head.dataset.dock === '1' ? under.backgroundColor : '';
  }

  // Out of the way on the way down, back on the way up. The header is fixed
  // and the page is long; a bar that never leaves is a bar you are always
  // reading past.
  let headLast = scrollY, headShown = true;
  function headDock() {
    if (!head) return;
    const y = scrollY;
    const top = y < 64;
    const down = y > headLast + 6;
    const up = y < headLast - 6;
    if (down && y > innerHeight * 0.6) headShown = false;
    else if (up || top) headShown = true;
    headLast = y;
    head.dataset.dock = top ? '' : '1';
    head.dataset.hide = headShown ? '' : '1';
  }

  // 1 · intros — one pinned shape cut. The backdrop is the field you came from.
  const intros = [...document.querySelectorAll<HTMLElement>('.intro')].map((n) => {
    const p = n.querySelector<HTMLElement>('.ipin');
    if (n.dataset.from && p) p.style.background = `var(--field-${n.dataset.from})`;
    // null until the first frame, which snaps: a cut should be in its correct
    // state on load or on a restored scroll, not animate in from nothing.
    return { n, cut: n.querySelector<HTMLElement>('.cut'), u: null as number | null };
  });
  const introU = (n: HTMLElement) => {
    const H = innerHeight;
    const top = n.getBoundingClientRect().top;
    const span = n.offsetHeight - H + H * 0.35;
    return ease(cl((H * 0.35 - top) / Math.max(1, span * 0.8)));
  };
  const introEnd = (n: HTMLElement) =>
    n.getBoundingClientRect().top + scrollY + (n.offsetHeight - innerHeight) * 0.85;

  // 2 · stage — many panels, one pin.
  const stages = [...document.querySelectorAll<HTMLElement>('.stage')].map((s) => {
    const panels = [...s.querySelectorAll<HTMLElement>('.panel')];
    // Not under reduced motion: the pin is released there, so giving the
    // stage six screens of height would leave six screens of nothing to
    // scroll past. The design says "pins released"; its own CSS only released
    // .intro, so the stage kept pinning and swapped panels abruptly.
    if (!reduce) {
      s.style.height = panels.length * 100 + 'svh';
      panels.forEach((p, i) => (p.style.zIndex = String(i)));
    }
    const t = document.createElement('div');
    t.className = 'ticks';
    t.setAttribute('aria-hidden', 'true');
    t.innerHTML = panels.map(() => '<i></i>').join('');
    s.querySelector('.pin')?.appendChild(t);
    return { s, panels, ticks: [...t.children] as HTMLElement[], x: null as number | null };
  });

  // 3 · marquee — base drift, boosted by scroll velocity, decaying per frame.
  const mq = [...document.querySelectorAll<HTMLElement>('.marquee .track')];
  mq.forEach((t) => (t.innerHTML += t.innerHTML));
  let mx = 0, lastY = scrollY, vel = 0;
  // The marquee used to own a second, permanently-running rAF. Damping needs
  // a frame clock too, and two loops means two clocks and double the
  // per-frame wake-ups, so there is one loop now and this is a step in it.
  function stepMarquee(dt: number) {
    if (reduce || !mq.length) return false;
    mq.forEach((t) => {
      mx -= (0.05 + Math.min(2.5, vel)) * dt;
      const w = t.scrollWidth / 2;
      if (-mx > w) mx += w;
      t.style.transform = `translate3d(${mx}px,0,0)`;
    });
    // Keeps the loop alive only while it is actually on screen.
    return mq.some((t) => {
      const r = t.getBoundingClientRect();
      return r.bottom > 0 && r.top < innerHeight;
    });
  }

  // 4 · chips — the active one takes its domain's field.
  const chipSecs = [...document.querySelectorAll<HTMLElement>('[data-chip]')];
  const chipsEl = document.getElementById('chips');
  let chipAct = -2;
  let chipLinks: HTMLElement[] = [];
  if (chipsEl && chipSecs.length) {
    chipsEl.dataset.hide = '1';
    chipsEl.innerHTML = `<div class="ctrack">${chipSecs
      .map((s, i) => `<a href="#${s.id}" data-jump="${i}">${s.dataset.chip}</a>`)
      .join('')}</div>`;
    chipLinks = [...chipsEl.querySelectorAll<HTMLElement>('a')];
  }
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLElement>('[data-jump]');
    if (!a) return;
    const s = chipSecs[Number(a.dataset.jump)];
    if (!s) return;
    e.preventDefault();
    const n = s.querySelector<HTMLElement>('.intro');
    scrollTo({ top: n ? introEnd(n) : s.offsetTop, behavior: reduce ? 'auto' : 'smooth' });
    history.replaceState(null, '', '#' + s.id);
  });

  // 5 · scrub — the Dave hero (MVBOLD-29). One <img> stepping through the
  // chaos-to-calm frames as the hero's scroll progresses. Frame 0 is already
  // in the markup; the rest load after `load`, coarse pass first, so the LCP
  // is one image and the scrub works within a few hundred KB. Swaps are hard
  // cuts at no more than 12 a second: it is stop-motion, and a faster swap
  // would read as a smeared video rather than as claymation.
  const PORTRAIT = matchMedia('(max-aspect-ratio: 4/5)');
  const frameUrl = (set: string, i: number) => `/hero/dave/${set}/${String(i).padStart(3, '0')}.webp`;
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const lean = !!conn && (conn.saveData === true || /(^|-)2g$|^3g$/.test(conn.effectiveType ?? ''));

  const scrubs = [...document.querySelectorAll<HTMLElement>('.hero.dave')].map((h) => {
    const img = h.querySelector<HTMLImageElement>('.dave-scene img')!;
    const o = {
      h, img,
      hint: h.querySelector<HTMLElement>('.dave-hint'),
      n: Number(h.dataset.frames) || 1,
      calm: Number(h.dataset.calm) || 0,
      set: PORTRAIT.matches ? 'p' : 'l',
      loaded: new Set<number>([0]),
      shown: 0,
      lastSwap: -Infinity,
      p: null as number | null,
      gen: 0,
    };
    if (!reduce) {
      h.style.height = '250svh';
      h.dataset.scrub = 'pre';
      h.dataset.set = o.set;
      // The <source> picked frame 0's crop for first paint. From here the
      // script owns the choice, so it goes, and the <img> takes the set's URL
      // directly; the browser already has that file.
      h.querySelector('.dave-scene source')?.remove();
      // Only when it differs (the portrait set): re-assigning the URL the
      // markup is still loading can log a second request for it.
      if (img.getAttribute('src') !== frameUrl(o.set, 0)) img.src = frameUrl(o.set, 0);
    }
    return o;
  });

  type Scrub = (typeof scrubs)[number];

  // Fetch and decode the set off-screen, four at a time. `gen` lets a set
  // change abandon a load already in flight. Frame 0 is fetched too unless it
  // is already loaded (it is, from the markup, for the set the page opened
  // on; after a rotation it is not, and must pass the same decode guard as
  // every other frame rather than be written straight into the <img>).
  async function loadFrames(o: Scrub) {
    const gen = ++o.gen;
    const order = loadOrder(o.n).filter((i) => !o.loaded.has(i));
    // On Save-Data or a slow connection, the coarse pass only.
    const coarse = new Set(loadOrder(o.n).slice(0, coarseCount(o.n)));
    const queue = lean ? order.filter((i) => coarse.has(i)) : order;
    const worker = async () => {
      while (queue.length && gen === o.gen) {
        const i = queue.shift()!;
        const im = new Image();
        im.src = frameUrl(o.set, i);
        try {
          await im.decode();
          if (gen === o.gen) o.loaded.add(i);
        } catch {
          // A frame that fails stays out of `loaded`; nearestLoaded never picks it.
        }
        wake();
      }
    };
    await Promise.all([worker(), worker(), worker(), worker()]);
  }

  function startScrubLoads() {
    if (reduce) return;
    scrubs.forEach((o) => { void loadFrames(o); });
  }
  // After `load`, and a turn later, so not one byte of it competes with the page.
  if (document.readyState === 'complete') setTimeout(startScrubLoads, 0);
  else addEventListener('load', () => setTimeout(startScrubLoads, 0), { once: true });

  PORTRAIT.addEventListener('change', () => {
    if (reduce) return;
    scrubs.forEach((o) => {
      o.set = PORTRAIT.matches ? 'p' : 'l';
      o.h.dataset.set = o.set;
      // Nothing of the new set is loaded yet. The old frame stays up
      // (object-fit keeps it cropped, not stretched) until the new set's
      // first decoded frame replaces it through the normal swap path; -1
      // forces that swap even if the index happens to match.
      o.loaded = new Set();
      o.shown = -1;
      o.lastSwap = -Infinity;
      void loadFrames(o);
    });
    wake();
  });

  function stepScrubs(now: number, dt: number, H: number) {
    let busy = false;
    scrubs.forEach((o) => {
      if (reduce) return;
      const r = o.h.getBoundingClientRect();
      const target = cl(-r.top / Math.max(1, o.h.offsetHeight - H));
      o.p = o.p === null ? target : damp(o.p, target, dt);
      if (Math.abs(target - o.p) > SETTLED) busy = true;

      const want = frameAt(o.p, o.n);
      const show = nearestLoaded(want, o.loaded, o.n);
      if (show >= 0 && show !== o.shown) {
        if (canSwap(now, o.lastSwap)) {
          o.img.src = frameUrl(o.set, show);
          o.shown = show;
          o.lastSwap = now;
        } else busy = true; // a swap is owed; keep the loop alive to pay it
      }
      // No "waiting on a frame" busy here: loadFrames wakes the loop after
      // every decode, and a frame that never arrives must not hold it awake.

      o.h.dataset.scrub = o.shown >= o.calm ? 'calm' : 'pre';
      if (o.hint) o.hint.style.opacity = String(1 - cl(o.p / 0.05));
    });
    return busy;
  }

  const ghosts = [...document.querySelectorAll<HTMLElement>('.ghostnum')];
  let ghostY: number | null = null;
  let raf = 0, running = false, lastT = performance.now(), headAt = -1, headDue = 0;

  function frame(now: number) {
    const dt = Math.min(64, now - lastT);
    lastT = now;
    vel *= 0.92;
    let busy = stepMarquee(dt);
    const H = innerHeight;

    // headColor hides the header, hit-tests a point and restores it. That is
    // far too much to do 60 times a second, and it only changes when the
    // field under the bar changes — so at most every 80ms, and only when the
    // page has actually moved.
    if (scrollY !== headAt && now >= headDue) {
      headAt = scrollY;
      headDue = now + 80;
      headDock();
      headColor();
    }

    intros.forEach((o) => {
      const c = o.cut;
      if (!c || reduce) return;
      const target = introU(o.n);
      // First frame snaps; after that the rendered value follows.
      o.u = o.u === null ? target : damp(o.u, target, dt);
      if (Math.abs(target - o.u) > SETTLED) busy = true;
      const u = o.u;
      c.style.clipPath = SHAPES[(Number(o.n.dataset.shape) || 0) % SHAPES.length](u);
      c.style.visibility = u <= 0 ? 'hidden' : 'visible';
      drift(c, 1 - u);
    });

    stages.forEach((st) => {
      const { s, panels, ticks } = st;
      const r = s.getBoundingClientRect();
      const h = s.offsetHeight - H;
      const p = cl(-r.top / h);
      const targetX = p * (panels.length - 1);
      // Damped on the stage's own progress rather than per panel, so the
      // whole sequence keeps its timing relative to itself — panel 3 cannot
      // drift out of step with panel 2 because they share one follower.
      st.x = st.x === null ? targetX : damp(st.x, targetX, dt);
      if (Math.abs(targetX - st.x) > SETTLED) busy = true;
      const x = st.x;
      panels.forEach((el, i) => {
        if (i > 0 && !reduce) {
          const u = ease(cl(x - (i - 1)));
          el.style.clipPath = SHAPES[(Number(el.dataset.shape) || i - 1) % SHAPES.length](u);
          el.style.visibility = u <= 0 ? 'hidden' : 'visible';
        }
        if (reduce && i > 0) el.style.visibility = Math.round(targetX) >= i ? 'visible' : 'hidden';
        if (!reduce) drift(el, (x - i) * -1.2);
      });
      // Rounded off the target, not the damped value: the tick bar is a
      // position readout and should not lag the panel it reports.
      const a = Math.round(targetX);
      if (ticks[0]?.parentElement) ticks[0].parentElement.style.color = getComputedStyle(panels[a]).color;
      ticks.forEach((t, j) => (t.dataset.on = j === a ? '1' : ''));
    });

    if (stepScrubs(now, dt, H)) busy = true;

    if (!reduce && ghosts.length) {
      const gTarget = Math.min(scrollY, H) * 0.3;
      ghostY = ghostY === null ? gTarget : damp(ghostY, gTarget, dt);
      if (Math.abs(gTarget - ghostY) > 0.05) busy = true;
      ghosts.forEach((g) => (g.style.transform = `translate3d(0,${ghostY}px,0)`));
    }

    if (chipLinks.length && chipsEl) {
      let a = -1;
      chipSecs.forEach((s, i) => { if (s.getBoundingClientRect().top <= H * 0.5) a = i; });
      const endEl = document.querySelector('[data-chips-end]');
      const end = !!endEl && endEl.getBoundingClientRect().top < H * 0.6;
      chipsEl.dataset.hide = a < 0 || end ? '1' : '';
      if (a !== chipAct) {
        chipAct = a;
        chipLinks.forEach((l, j) => {
          const on = j === a;
          const f = chipSecs[j].dataset.field;
          l.style.background = on ? `var(--field-${f})` : '';
          l.style.color = on ? `var(--on-${f})` : '';
          if (on) l.setAttribute('aria-current', 'true');
          else l.removeAttribute('aria-current');
        });
        const l = chipLinks[a];
        if (l) {
          const t = l.parentElement!;
          t.scrollTo({ left: l.offsetLeft - (t.clientWidth - l.offsetWidth) / 2, behavior: 'smooth' });
        }
      }
    }

    // Anything mid-transition, or any animated section within a screen of the
    // viewport, keeps the loop open. Otherwise it stops and waits for the next
    // scroll — a permanently-running rAF that renders nothing is a wake-up per
    // frame for no reason.
    const near = (el: Element) => {
      const r = el.getBoundingClientRect();
      return r.bottom > -H && r.top < H * 2;
    };
    if (!busy && !stages.some((o) => near(o.s)) && !intros.some((o) => near(o.n)) && !scrubs.some((o) => near(o.h))) {
      running = false;
      raf = 0;
      return;
    }
    raf = requestAnimationFrame(frame);
  }

  function wake() {
    if (running) return;
    running = true;
    lastT = performance.now();
    raf = requestAnimationFrame(frame);
  }

  addEventListener('scroll', () => {
    const dy = Math.abs(scrollY - lastY);
    lastY = scrollY;
    vel = Math.max(vel, (dy / 16) * 0.25);
    wake();
  }, { passive: true });

  addEventListener('resize', () => {
    if (!reduce) stages.forEach(({ s, panels }) => (s.style.height = panels.length * 100 + 'svh'));
    wake();
  });

  wake();
</script>
